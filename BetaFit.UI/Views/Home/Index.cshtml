@model HomeViewModel
@{ViewData["Title"]="Início";var slides=Model.SiteSettings.HeroSlides.Where(x=>!string.IsNullOrWhiteSpace(x.Title)).ToList();if(!slides.Any()){slides.Add(new HeroSlideDto{Title="Vista sua disciplina.",Subtitle="Performance, conforto e identidade em cada peça.",ButtonText="Ver coleção",ButtonUrl="/Catalog"});}}
<section class="bf-home-hero" data-hero-carousel>@for(var i=0;i<slides.Count;i++){var slide=slides[i];<article class="bf-home-hero__slide @(i==0?"is-active":"")" data-hero-slide>@if(slide.MediaType=="video"&&!string.IsNullOrWhiteSpace(slide.MediaUrl)){<video autoplay muted loop playsinline><source src="@slide.MediaUrl" /></video>}else if(!string.IsNullOrWhiteSpace(slide.MediaUrl)){<div class="bf-home-hero__media" style="background-image:url('@slide.MediaUrl')"></div>}<div class="bf-home-hero__overlay"></div><div class="bf-container bf-home-hero__content"><span>Beta Fit · Coleções especiais</span><h1>@slide.Title</h1><p>@slide.Subtitle</p><a class="bf-btn bf-btn--primary" href="@slide.ButtonUrl">@slide.ButtonText →</a></div></article>}@if(slides.Count>1){<button class="bf-home-hero__arrow prev" data-hero-prev>‹</button><button class="bf-home-hero__arrow next" data-hero-next>›</button><div class="bf-home-hero__dots">@for(var i=0;i<slides.Count;i++){<button class="@(i==0?"is-active":"")" data-hero-dot="@i" aria-label="Slide @(i+1)"></button>}</div>}</section>
<div class="bf-event-strip">PERFORMANCE • CONFORTO • EDIÇÕES ESPECIAIS • NOVOS PRODUTOS • BETA FIT</div>
<section class="bf-section"><div class="bf-container"><div class="bf-section__head"><div><span class="bf-eyebrow bf-eyebrow--dark">Novidades</span><h2>Acabaram de chegar</h2></div><a asp-controller="Catalog" asp-action="Index">Ver todos →</a></div>@await Html.PartialAsync("_ProductRail",Model.RecentProducts)</div></section>
@foreach(var group in Model.ProductsByCategory){<section class="bf-section bf-section--soft"><div class="bf-container"><div class="bf-section__head"><div><span class="bf-eyebrow bf-eyebrow--dark">Coleção</span><h2>@group.Key</h2></div><a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@group.Value.First().CategoryId">Ver categoria →</a></div>@await Html.PartialAsync("_ProductRail",group.Value)</div></section>}
<section class="bf-section bf-home-values"><div class="bf-container"><div class="bf-home-values__grid"><article><strong>01</strong><h3>Compra segura</h3><p>Checkout demonstrativo com validações próximas a uma experiência real.</p></article><article><strong>02</strong><h3>Escolha completa</h3><p>Compare fotos de cada cor e escolha tamanho apenas na página do produto.</p></article><article><strong>03</strong><h3>Acompanhe tudo</h3><p>Receba notificações no site e por email a cada etapa importante.</p></article></div></div></section>
