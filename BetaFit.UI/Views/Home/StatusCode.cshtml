@model int
@{
    ViewData["Title"] = Model switch { 404 => "Página não encontrada", 401 => "Sessão necessária", 403 => "Acesso negado", _ => "Não foi possível concluir" };
    var title = Model switch { 404 => "Página não encontrada.", 401 => "Sua sessão precisa ser renovada.", 403 => "Acesso negado.", _ => "Não foi possível concluir." };
    var message = Model switch { 404 => "O endereço pode estar incorreto ou o registro não existe mais.", 401 => "Entre novamente para continuar com segurança.", 403 => "Sua conta não possui permissão para acessar este recurso.", _ => "Tente novamente em alguns instantes." };
}
<section class="bf-simple-page">
    <div class="bf-simple-page__card">
        <span class="bf-eyebrow bf-eyebrow--dark">Beta Fit</span>
        <div class="bf-simple-page__code">@Model</div>
        <h1>@title</h1>
        <p>@message</p>
        <a class="bf-btn bf-btn--dark" asp-controller="Home" asp-action="Index">Voltar para a Home <span>→</span></a>
    </div>
</section>
