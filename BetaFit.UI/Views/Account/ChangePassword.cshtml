@{ViewData["Title"]="Alterar senha";var pending=ViewData["PendingChange"] as BetaFit.Application.DTOs.PendingChangeStatusDto;}
<section class="bf-section"><div class="bf-security-page"><a class="bf-back-link" asp-action="Profile">← Minha conta</a><span class="bf-eyebrow">Segurança da conta</span><h1>Alterar senha</h1><p>Confirme sua senha atual e escolha uma nova senha.</p>
@if(TempData["Erro"] is string error){<div class="bf-alert bf-alert--error" role="alert">@error</div>}@if(TempData["Sucesso"] is string ok){<div class="bf-alert" role="status">@ok</div>}
@if(pending?.CanConfirm==true && !pending.IsEmailChange){<div class="bf-security-card"><h2>Confirme a alteração</h2><p>Digite o código enviado para @pending.Email. Ele vale por 10 minutos.</p><form asp-action="ConfirmProfileChange" method="post" class="bf-form">@Html.AntiForgeryToken()<input type="hidden" name="passwordChange" value="true"/><label>Código de confirmação<input name="token" pattern="[0-9]{6}" maxlength="6" inputmode="numeric" autocomplete="one-time-code" required/></label><button class="bf-btn bf-btn--dark">Confirmar nova senha</button></form></div>}
else{<form asp-action="UpdatePassword" method="post" class="bf-form bf-security-card" data-password-change>@Html.AntiForgeryToken()<label>Senha atual<div class="bf-password-input-wrap"><input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" maxlength="100" required/><button type="button" class="bf-password-toggle" data-password-toggle="#currentPassword" aria-label="Mostrar senha atual">Mostrar</button></div></label><label>Nova senha<div class="bf-password-input-wrap"><input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="6" maxlength="100" required/><button type="button" class="bf-password-toggle" data-password-toggle="#newPassword" aria-label="Mostrar nova senha">Mostrar</button></div></label><label>Confirmar nova senha<div class="bf-password-input-wrap"><input id="confirmNewPassword" name="confirmNewPassword" type="password" autocomplete="new-password" minlength="6" maxlength="100" required/><button type="button" class="bf-password-toggle" data-password-toggle="#confirmNewPassword" aria-label="Mostrar confirmação da senha">Mostrar</button></div></label><div class="bf-change-strength" data-change-strength><div class="bf-password-meter"><span data-strength-bar></span></div><p data-strength-label role="status" aria-live="polite">Digite sua nova senha.</p><ul><li data-check="length">Pelo menos 6 caracteres</li><li data-check="upper">Letra maiúscula</li><li data-check="lower">Letra minúscula</li><li data-check="digit">Número</li><li data-check="special">Símbolo</li><li data-check="match">Senhas iguais</li></ul></div><small>Use letras maiúsculas e minúsculas, números e símbolos. A confirmação será enviada ao seu e-mail.</small><button class="bf-btn bf-btn--dark">Enviar código de confirmação</button></form>}
</div></section>
