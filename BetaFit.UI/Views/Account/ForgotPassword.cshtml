@model ForgotPasswordDto
@{ ViewData["Title"] = "Esqueci minha senha"; }
<section class="bf-auth-page"><div class="bf-auth-visual"><span>BETAFIT</span><strong>RECUPERE<br /><em>SEU ACESSO.</em></strong></div><div class="bf-auth-panel"><div class="bf-auth-panel__inner"><a class="bf-back-link" asp-action="Login">← Voltar para entrar</a><span class="bf-eyebrow bf-eyebrow--dark">Segurança</span><h1>Esqueci<br />minha senha.</h1><p class="bf-auth-intro">Informe seu e-mail. Se a conta existir, enviaremos um link seguro para redefinir a senha.</p>@if(TempData["Sucesso"] is string ok){<div class="bf-alert" role="status">@ok</div>}@if(!ViewData.ModelState.IsValid){<div class="bf-alert bf-alert--error" role="alert">@Html.ValidationSummary(true,"",new{@class="bf-validation"})</div>}<form asp-action="ForgotPassword" method="post" class="bf-form">@Html.AntiForgeryToken()<label>E-mail<input asp-for="Email" type="email" autocomplete="email" required /></label><button class="bf-btn bf-btn--dark bf-btn--wide" type="submit">Enviar link <span>→</span></button></form></div></div></section>
