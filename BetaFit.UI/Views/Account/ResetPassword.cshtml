@model ResetPasswordDto
@{ ViewData["Title"] = "Redefinir senha"; }
<section class="bf-auth-page"><div class="bf-auth-visual"><span>BETAFIT</span><strong>NOVA<br /><em>SENHA.</em></strong></div><div class="bf-auth-panel"><div class="bf-auth-panel__inner"><span class="bf-eyebrow bf-eyebrow--dark">Segurança</span><h1>Redefinir<br />senha.</h1>@if(!ViewData.ModelState.IsValid){<div class="bf-alert bf-alert--error" role="alert">@Html.ValidationSummary(true,"",new{@class="bf-validation"})</div>}<form asp-action="ResetPassword" method="post" class="bf-form">@Html.AntiForgeryToken()<input asp-for="Token" type="hidden" /><label>E-mail<input asp-for="Email" type="email" autocomplete="email" required /></label><div class="bf-password-field"><label for="NewPassword">Nova senha</label><div class="bf-password-input-wrap"><input asp-for="NewPassword" type="password" minlength="6" autocomplete="new-password" required /><button type="button" class="bf-password-toggle" data-password-toggle="#NewPassword">Mostrar</button></div><div class="bf-password-meter"><span id="password-meter-bar"></span></div></div><div class="bf-password-field"><label for="ConfirmPassword">Confirmar senha</label><div class="bf-password-input-wrap"><input asp-for="ConfirmPassword" type="password" minlength="6" autocomplete="new-password" required /><button type="button" class="bf-password-toggle" data-password-toggle="#ConfirmPassword">Mostrar</button></div></div><button class="bf-btn bf-btn--dark bf-btn--wide" type="submit">Redefinir senha <span>→</span></button></form></div></div></section>
