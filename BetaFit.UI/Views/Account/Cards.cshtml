@model UserDto
@{ ViewData["Title"]="Meus cartões"; var form = ViewData["CardForm"] as PaymentCardDto ?? new PaymentCardDto(); }
<section class="bf-page-hero bf-page-hero--compact"><div class="bf-container bf-page-hero__inner"><div><h1>Meus cartões</h1><p>Adicione cartões de crédito e débito e gerencie os que já cadastrou.</p></div></div></section>
<section class="bf-section"><div class="bf-container bf-profile-page">
<a class="bf-text-link" asp-action="Profile">← Minha conta</a>
@if(TempData["Sucesso"] is string ok){<div class="bf-alert" role="status">@ok</div>}
@if(TempData["Erro"] is string error){<div class="bf-alert bf-alert--error" role="alert">@error</div>}
@if (!ViewData.ModelState.IsValid) { <div class="bf-alert bf-alert--error bf-card-errors" role="alert"><strong>Não foi possível cadastrar o cartão.</strong><div asp-validation-summary="All" class="bf-validation"></div><p>Revise os dados abaixo. Por segurança, informe o CVV novamente.</p></div> }
<h2>Cartões cadastrados (@Model.Cards.Count)</h2><div class="bf-wallet">@if (!Model.Cards.Any()) { <p>Você ainda não cadastrou cartões de crédito ou débito.</p> }@foreach(var card in Model.Cards){<article><strong>@(card.Type=="Credito"?"Crédito":"Débito") · @card.Brand •••• @card.Last4</strong><span>@card.Holder · @card.Expiry</span><form asp-action="DeleteCard" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@card.Id" /><button type="submit" class="bf-text-link">Excluir cartão</button></form></article>}</div><h2 id="adicionar-cartao">Adicionar cartão</h2><form asp-action="UpdateCard" method="post" class="bf-form bf-form--admin" data-card-form>@Html.AntiForgeryToken()<div class="bf-demo-card-help"><p>Quer testar o cadastro? Preencha um cartão de demonstração válido, sem cobrança.</p><button type="button" class="bf-btn bf-btn--outline" data-fill-demo-card>Preencher cartão de teste</button></div><div class="bf-form-grid"><label>Tipo de cartão<select name="Type"><option value="Credito" selected="@(form.Type == "Credito")">Crédito</option><option value="Debito" selected="@(form.Type == "Debito")">Débito</option></select></label><label class="bf-form-grid__full">Nome impresso no cartão<input name="CardHolderName" value="@form.CardHolderName" minlength="3" maxlength="120" autocomplete="cc-name" required /></label><label>Número do cartão<input name="CardNumber" value="@form.CardNumber" inputmode="numeric" minlength="13" maxlength="23" autocomplete="cc-number" data-card-number placeholder="4111111111111111" required /></label><label>Validade<input name="Expiry" value="@form.Expiry" maxlength="5" inputmode="numeric" autocomplete="cc-exp" data-card-expiry placeholder="MM/AA" required /></label><label>Código de segurança<input name="SecurityCode" type="password" inputmode="numeric" minlength="3" maxlength="4" autocomplete="cc-csc" placeholder="CVV" required /></label></div><p class="bf-form-hint">Use, por exemplo, o cartão de teste Visa 4111111111111111. O número cinza dentro do campo é apenas um exemplo; clique em Preencher cartão de teste para usá-lo. Nenhuma cobrança real será feita.</p><button class="bf-btn bf-btn--dark" type="submit">Salvar cartão demonstrativo</button></form>
</div></section>