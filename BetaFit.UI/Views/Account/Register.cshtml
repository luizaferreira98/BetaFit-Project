@model RegisterDto
@{ ViewData["Title"]="Criar conta"; }
<section class="bf-auth-page"><div class="bf-auth-visual"><span>BETAFIT</span><strong>COMECE<br /><em>SUA JORNADA.</em></strong></div><div class="bf-auth-panel"><div class="bf-auth-panel__inner"><a class="bf-back-link" asp-controller="Home" asp-action="Index">← Voltar para a loja</a><span class="bf-eyebrow bf-eyebrow--dark">Área do cliente</span><h1>Criar sua<br />conta.</h1><p class="bf-auth-intro">Preencha seus dados para criar sua conta Beta Fit.</p>
@if(!ViewData.ModelState.IsValid){<div class="bf-alert bf-alert--error" role="alert">@Html.ValidationSummary(true,"",new{@class="bf-validation"})</div>}
<form asp-controller="Account" asp-action="Register" method="post" class="bf-form">@Html.AntiForgeryToken()
<label>Nome completo<input asp-for="FullName" autocomplete="name" maxlength="120" placeholder="Seu nome completo" required /></label>
<label>E-mail<input asp-for="Email" type="email" autocomplete="email" maxlength="256" placeholder="voce@email.com" required /></label>
<label>Telefone<input asp-for="PhoneNumber" type="tel" autocomplete="tel" inputmode="tel" maxlength="15" minlength="10" placeholder="(11) 99999-9999" data-phone-mask required /></label>
<label>Data de nascimento<input asp-for="BirthDate" type="date" autocomplete="bday" required /></label>
<p class="bf-form-hint">É necessário ter 18 anos ou mais para criar uma conta.</p>
<label>Senha<input asp-for="Password" type="password" autocomplete="new-password" minlength="6" placeholder="Mínimo de 6 caracteres" required /></label>
<label>Confirmar senha<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="6" placeholder="Repita sua senha" required /></label>
<label class="bf-check"><input type="checkbox" required /><span>Li e aceito os <a asp-controller="Home" asp-action="Terms">Termos de Uso</a> e a <a asp-controller="Home" asp-action="Privacy">Política de Privacidade</a>.</span></label>
<button class="bf-btn bf-btn--dark bf-btn--wide" type="submit">Criar conta <span>→</span></button></form><p class="bf-auth-switch">Já possui uma conta? <a asp-controller="Account" asp-action="Login">Entrar</a></p></div></div></section>
