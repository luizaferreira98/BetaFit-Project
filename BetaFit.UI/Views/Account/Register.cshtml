@model RegisterDto
@{
    ViewData["Title"] = "Criar conta";
}
<section class="bf-auth-page">
    <div class="bf-auth-visual"><span>BETAFIT</span><strong>COMECE<br /><em>SUA JORNADA.</em></strong></div>
    <div class="bf-auth-panel">
        <div class="bf-auth-panel__inner">
            <a class="bf-back-link" asp-controller="Home" asp-action="Index">← Voltar para a loja</a>
            <span class="bf-eyebrow bf-eyebrow--dark">Área do cliente</span>
            <h1>Criar sua<br />conta.</h1>
            <p class="bf-auth-intro">Cadastre-se para ter acesso à sua experiência Beta Fit.</p>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bf-alert bf-alert--error" role="alert">@Html.ValidationSummary(true, "", new { @class = "bf-validation" })</div>
            }
            <form asp-controller="Account" asp-action="Register" method="post" class="bf-form">
                @Html.AntiForgeryToken()
                <label>E-mail<input asp-for="Email" type="email" autocomplete="email" placeholder="voce@email.com" required /></label>
                <label>Senha<input asp-for="Password" type="password" autocomplete="new-password" placeholder="Mínimo de 6 caracteres" minlength="6" required /></label>
                <label>Confirmar senha<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Repita sua senha" minlength="6" required /></label>
                <button class="bf-btn bf-btn--dark bf-btn--wide" type="submit">Criar conta <span>→</span></button>
            </form>
            <p class="bf-auth-switch">Já possui uma conta? <a asp-controller="Account" asp-action="Login">Entrar</a></p>
        </div>
    </div>
</section>
