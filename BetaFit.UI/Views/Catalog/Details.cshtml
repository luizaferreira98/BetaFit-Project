@model ProductDto
@{
    var apiUnavailable = (bool)(ViewData["ApiUnavailable"] ?? false);
    var relatedProducts = (IReadOnlyList<ProductDto>)(ViewData["RelatedProducts"] ?? Array.Empty<ProductDto>());
    ViewData["Title"] = Model?.Name ?? "Produto";
}

@if (apiUnavailable)
{
    <div class="bf-container bf-alert-wrap"><div class="bf-alert" role="alert"><span class="bf-alert__dot"></span>O serviço de catálogo está temporariamente indisponível. Inicie a BetaFit.API e tente novamente.</div></div>
}

@if (Model is not null)
{
    var product = Model;
    <section class="bf-product-page">
        <div class="bf-container">
            <a class="bf-back-link" asp-controller="Catalog" asp-action="Index">← Voltar ao catálogo</a>
            <div class="bf-product-detail">
                <div class="bf-product-detail__media">
                    @if (product.IsFeatured)
                    {
                        <span class="bf-product-card__badge">Destaque</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" alt="@product.Name" />
                    }
                    else
                    {
                        <div class="bf-product-detail__placeholder">BF</div>
                    }
                </div>

                <div class="bf-product-detail__content">
                    <span class="bf-eyebrow bf-eyebrow--dark">@product.CategoryName</span>
                    <h1>@product.Name</h1>
                    <div class="bf-product-detail__price">@product.Price.ToString("C")</div>
                    <div class="bf-product-detail__rule"></div>
                    @if (TempData["Error"] is string errorMessage)
                    {
                        <div class="bf-alert bf-alert--error" role="alert">@errorMessage</div>
                    }
                    <p class="bf-product-detail__desc">@product.Description</p>

                    <div class="bf-product-specs">
                        <div><span>Categoria</span><strong>@product.CategoryName</strong></div>
                        <div><span>Gênero</span><strong>@product.Gender</strong></div>
                    </div>

                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Catalog" asp-action="AddToCart" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@product.Id" />
                            <div class="bf-quantity-row">
                                <label for="product-quantity">Quantidade</label>
                                <div class="bf-quantity-control" data-quantity-control>
                                    <button type="button" class="bf-quantity-btn" data-quantity-minus aria-label="Diminuir quantidade">−</button>
                                    <input id="product-quantity" class="bf-quantity-input" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" />
                                    <button type="button" class="bf-quantity-btn" data-quantity-plus aria-label="Aumentar quantidade">+</button>
                                </div>
                            </div>
                            <button class="bf-btn bf-btn--dark bf-btn--wide" type="submit">Adicionar ao carrinho <span>→</span></button>
                        </form>
                    }
                    else
                    {
                        <div class="bf-login-required">
                            <strong>Entre na sua conta para adicionar este produto.</strong>
                            <p>Seu carrinho é exclusivo para usuários autenticados.</p>
                            <a class="bf-btn bf-btn--dark bf-btn--wide" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">Entrar para continuar <span>→</span></a>
                        </div>
                    }

                    <p class="bf-demo-note">Preço demonstrativo. Este é um projeto institucional de portfólio, sem venda real.</p>
                </div>
            </div>
        </div>
    </section>

    @if (relatedProducts.Any())
    {
        <section class="bf-section bf-section--soft">
            <div class="bf-container">
                <div class="bf-section__head">
                    <div><span class="bf-eyebrow bf-eyebrow--dark">Você também pode gostar</span><h2>Produtos relacionados</h2></div>
                    <a class="bf-section-link" asp-controller="Catalog" asp-action="Index">Ver catálogo <span>→</span></a>
                </div>
                <div class="bf-product-grid">
                    @foreach (var related in relatedProducts)
                    {
                        <a class="bf-product-card" asp-controller="Catalog" asp-action="Details" asp-route-id="@related.Id">
                            <div class="bf-product-card__media">
                                @if (!string.IsNullOrWhiteSpace(related.ImageUrl))
                                {
                                    <img src="@related.ImageUrl" alt="@related.Name" loading="lazy" />
                                }
                                else
                                {
                                    <div class="bf-product-card__placeholder">BF</div>
                                }
                            </div>
                            <div class="bf-product-card__body"><span class="bf-product-card__cat">@related.CategoryName</span><strong>@related.Name</strong><span class="bf-product-card__price">@related.Price.ToString("C")</span></div>
                        </a>
                    }
                </div>
            </div>
        </section>
    }
}
