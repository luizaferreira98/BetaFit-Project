@model ProductDto
@using BetaFit.UI.Helpers
@{ var apiUnavailable=(bool)(ViewData["ApiUnavailable"]??false); var relatedProducts=(IReadOnlyList<ProductDto>)(ViewData["RelatedProducts"]??Array.Empty<ProductDto>()); ViewData["Title"]=Model?.Name??"Produto"; var images=Model?.ImageUrls?.Any()==true?Model.ImageUrls:(string.IsNullOrWhiteSpace(Model?.ImageUrl)?new List<string>():new List<string>{Model!.ImageUrl!}); var sizes=Model?.AvailableSizes??new List<string>(); var requiresSize=ProductCatalogRules.RequiresSize(Model?.CategoryName); }
@if(apiUnavailable){<div class="bf-container bf-alert-wrap"><div class="bf-alert">O serviço de catálogo está temporariamente indisponível.</div></div>}
@if(Model is not null){<section class="bf-product-page"><div class="bf-container"><a class="bf-back-link" asp-controller="Catalog" asp-action="Index">← Voltar ao catálogo</a><div class="bf-product-detail"><div class="bf-product-detail__media bf-gallery">@if(Model.IsFeatured){<span class="bf-product-card__badge">Destaque</span>}<div class="bf-gallery__main">@if(images.Any()){<img id="bf-main-product-image" src="@images.First()" alt="@Model.Name" />}else{<div class="bf-product-detail__placeholder">BF</div>}</div>@if(images.Count>1){<div class="bf-gallery__thumbs">@foreach(var img in images){<button type="button" class="bf-gallery__thumb" data-gallery-image="@img"><img src="@img" alt="@Model.Name" loading="lazy" /></button>}</div>}</div><div class="bf-product-detail__content"><span class="bf-eyebrow bf-eyebrow--dark">@Model.CategoryName</span><h1>@Model.Name</h1><div class="bf-product-detail__price">@Model.Price.ToString("C")</div><div class="bf-product-detail__rule"></div>@if(TempData["Error"] is string e){<div class="bf-alert bf-alert--error">@e</div>}<p class="bf-product-detail__desc">@Model.Description</p><div class="bf-product-specs"><div><span>Categoria</span><strong>@Model.CategoryName</strong></div><div><span>Gênero</span><strong>@Model.Gender</strong></div></div>@if(User?.Identity?.IsAuthenticated==true){<div class="bf-product-actions-row"><form asp-controller="Favorites" asp-action="Toggle" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" /><button class="bf-btn bf-btn--outline" type="submit">♡ Adicionar aos favoritos</button></form></div><form asp-controller="Catalog" asp-action="AddToCart" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><div class="bf-product-choice-grid">@if(requiresSize && sizes.Any()){<label>Tamanho<select name="size" required><option value="">Escolha o tamanho</option>@foreach(var size in sizes){<option value="@size">@size</option>}</select></label>}<label>Quantidade<div class="bf-quantity-control" data-quantity-control><button type="button" class="bf-quantity-btn" data-quantity-minus>−</button><input id="product-quantity" class="bf-quantity-input" type="number" name="quantity" value="1" min="1" max="99" /><button type="button" class="bf-quantity-btn" data-quantity-plus>+</button></div></label></div><button class="bf-btn bf-btn--dark bf-btn--wide" type="submit">Adicionar ao carrinho <span>→</span></button></form>}else{<div class="bf-login-required"><strong>Entre na sua conta para adicionar produtos e favoritos.</strong><a class="bf-btn bf-btn--dark bf-btn--wide" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">Entrar para continuar <span>→</span></a></div>}<p class="bf-demo-note">Preço demonstrativo. Este é um projeto institucional de portfólio, sem venda real.</p></div></div></div></section>
@if(relatedProducts.Any()){<section class="bf-section bf-section--soft"><div class="bf-container"><div class="bf-section__head"><div><span class="bf-eyebrow bf-eyebrow--dark">Você também pode gostar</span><h2>Produtos relacionados</h2></div></div><div class="bf-product-grid">@foreach(var related in relatedProducts){<a class="bf-product-card" asp-controller="Catalog" asp-action="Details" asp-route-id="@related.Id"><div class="bf-product-card__media bf-product-card__media--carousel" data-product-carousel><div class="bf-product-card__slides">@{var relatedImages=related.ImageUrls?.Any()==true?related.ImageUrls:(string.IsNullOrWhiteSpace(related.ImageUrl)?new List<string>():new List<string>{related.ImageUrl!});}@foreach(var img in relatedImages){<img src="@img" alt="@related.Name" loading="lazy" decoding="async" />}</div>@if(relatedImages.Count>1){<span class="bf-product-card__carousel-hint" aria-hidden="true">@relatedImages.Count fotos</span>}</div><div class="bf-product-card__body"><span class="bf-product-card__cat">@related.CategoryName</span><strong>@related.Name</strong><span class="bf-product-card__price">@related.Price.ToString("C")</span></div></a>}</div></div></section>}}
