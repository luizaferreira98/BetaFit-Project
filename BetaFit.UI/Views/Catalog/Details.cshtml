@model ProductDto
@{
    var apiUnavailable = (bool)(ViewData["ApiUnavailable"] ?? false);
    var relatedProducts = (IReadOnlyList<ProductDto>)(ViewData["RelatedProducts"] ?? Array.Empty<ProductDto>());
    var productReviews = ViewData["Reviews"] as IEnumerable<ReviewDto> ?? Array.Empty<ReviewDto>();
    ViewData["Title"] = Model?.Name ?? "Produto";
    var images = Model?.ImageUrls?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? new List<string>();
    if (images.Count == 0 && !string.IsNullOrWhiteSpace(Model?.ImageUrl)) images.Add(Model.ImageUrl!);
    var sizes = Model?.AvailableSizes?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? new List<string>();
    var requiresSize = sizes.Count > 0;
    var colors = Model?.AvailableColors?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? new List<string>();
    var reviewCount = productReviews.Count();
    var reviewAverage = reviewCount == 0 ? 0 : productReviews.Average(x => x.Rating);
}

@if (apiUnavailable) { <div class="bf-container bf-alert-wrap"><div class="bf-alert">O serviço de catálogo está temporariamente indisponível.</div></div> }

@if (Model is not null)
{
    <section class="bf-product-page"><div class="bf-container">
        <a class="bf-back-link" asp-controller="Catalog" asp-action="Index">← Voltar ao catálogo</a>
        <div class="bf-product-detail bf-product-detail--store">
            <div class="bf-product-gallery" data-product-gallery>
                @if (Model.IsFeatured) { <span class="bf-product-card__badge">Destaque</span> }
                @if (images.Any())
                {
                    <div class="bf-product-gallery__thumbs" aria-label="Fotos do produto">
                        @for (var index = 0; index < images.Count; index++)
                        {
                            <button type="button" class="bf-product-gallery__thumb @(index == 0 ? "is-active" : "")" data-gallery-select="@index" aria-label="Ver foto @(index + 1) de @images.Count">
                                <img src="@images[index]" alt="Miniatura de @Model.Name" loading="lazy" />
                            </button>
                        }
                    </div>
                    <div class="bf-product-gallery__stage">
                        <img src="@images[0]" alt="@Model.Name" data-gallery-main />
                        @if (images.Count > 1)
                        {
                            <button type="button" class="bf-product-gallery__arrow bf-product-gallery__arrow--prev" data-gallery-previous aria-label="Foto anterior">‹</button>
                            <button type="button" class="bf-product-gallery__arrow bf-product-gallery__arrow--next" data-gallery-next aria-label="Próxima foto">›</button>
                        }
                        <button type="button" class="bf-product-gallery__expand" data-gallery-expand aria-label="Ampliar foto"><span>⤢</span><small>Ampliar</small></button>
                        <span class="bf-product-gallery__count" data-gallery-count>1 / @images.Count</span>
                    </div>
                }
                else { <div class="bf-product-detail__placeholder">BF</div> }
            </div>

            <div class="bf-product-detail__content">
                <span class="bf-eyebrow bf-eyebrow--dark">@Model.CategoryName</span>
                <h1>@Model.Name</h1>
                <a class="bf-product-rating" href="#avaliacoes" aria-label="@reviewCount avaliações, média @reviewAverage.ToString("0.0") de 5">
                    <span>★★★★★</span><strong>@(reviewCount == 0 ? "Sem avaliações" : reviewAverage.ToString("0.0"))</strong><small>(@reviewCount @(reviewCount == 1 ? "avaliação" : "avaliações"))</small>
                </a>
                <div class="bf-product-detail__price">@Model.Price.ToString("C")</div>
                @if (Model.Stock <= 0) { <div class="bf-alert bf-alert--error">Produto esgotado no momento.</div> }
                @if (TempData["Error"] is string errorMessage) { <div class="bf-alert bf-alert--error">@errorMessage</div> }

                <div class="bf-product-specs"><div><span>Categoria</span><strong>@Model.CategoryName</strong></div><div><span>Gênero</span><strong>@Model.Gender</strong></div><div><span>Cores disponíveis</span><strong>@(colors.Any()?string.Join(", ",colors):"Cor única")</strong></div></div>

                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div class="bf-product-actions-row"><form asp-controller="Favorites" asp-action="Toggle" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" /><button class="bf-btn bf-btn--outline" type="submit">@((ViewData["IsFavorite"] as bool?) == true ? "♥ Favoritado" : "♡ Adicionar aos favoritos")</button></form></div>
                    <form asp-controller="Catalog" asp-action="AddToCart" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <div class="bf-product-choice-grid">
                            @if (requiresSize) { <fieldset class="bf-detail-options"><legend>Tamanho: <strong data-selected-size>selecione</strong></legend><div class="bf-size-buttons">@foreach (var size in sizes) { <label><input type="radio" name="size" value="@size" required /><span>@size</span></label> }</div><button class="bf-size-guide-trigger" type="button" data-size-guide-open>⌁ Tabela de medidas</button></fieldset> }
                            @if (colors.Any()) { <fieldset class="bf-detail-options bf-detail-colors"><legend>Cor: <strong data-selected-color>selecione</strong></legend><div class="bf-color-variant-list">@foreach(var color in colors){Model.ColorImageUrls.TryGetValue(color,out var colorImage);<label title="@color"><input type="radio" name="color" value="@color" required data-color-choice data-color-image="@colorImage" /><span>@if(!string.IsNullOrWhiteSpace(colorImage)){<img src="@colorImage" alt="@color" />}else{<i class="bf-color-dot" data-color="@color"></i>}<small>@color</small></span></label>}</div></fieldset> }
                            <label>Quantidade<div class="bf-quantity-control" data-quantity-control><button type="button" class="bf-quantity-btn" data-quantity-minus>−</button><input id="product-quantity" class="bf-quantity-input" type="number" name="quantity" value="1" min="1" max="99" /><button type="button" class="bf-quantity-btn" data-quantity-plus>+</button></div></label>
                        </div>
                        @if (Model.Stock <= 0) { <button class="bf-btn bf-btn--dark bf-btn--wide" type="button" disabled>Produto esgotado</button> } else { <button class="bf-btn bf-btn--dark bf-btn--wide" type="submit">Adicionar ao carrinho <span>→</span></button> }
                    </form>
                    <div class="bf-product-benefits"><span>❄<small>Toque gelado</small></span><span>☀<small>Proteção UV</small></span><span>≋<small>Secagem rápida</small></span><span>⌁<small>Anti odor</small></span><span>↔<small>Liberdade total</small></span></div>
                }
                else if (User?.Identity?.IsAuthenticated != true) { <div class="bf-login-required"><strong>Entre na sua conta para adicionar produtos e favoritos.</strong><a class="bf-btn bf-btn--dark bf-btn--wide" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">Entrar para continuar <span>→</span></a></div>       }
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <details class="bf-product-description"><summary><span>Descrição</span><b>+</b></summary><p>@Model.Description</p></details>
                }
                <p class="bf-demo-note">Frete grátis em compras acima de R$ 299 · pagamento demonstrativo disponível no checkout.</p>
            </div>
        </div>
    </div></section>
}

<section class="bf-section bf-reviews" id="avaliacoes"><div class="bf-container"><div class="bf-section__head"><div><span class="bf-eyebrow bf-eyebrow--dark">Experiências reais</span><h2>Avaliações</h2></div></div>
@if (!productReviews.Any()) { <div class="bf-empty"><strong>Ainda não há avaliações.</strong><span>As primeiras avaliações aparecerão aqui após pedidos entregues.</span></div> }
else { <div class="bf-reviews-grid">@foreach (var review in productReviews) { var stars = new string('★', Math.Clamp(review.Rating, 0, 5)); var emptyStars = new string('☆', 5 - Math.Clamp(review.Rating, 0, 5)); <article class="bf-review-card"><div class="bf-review-card__stars" aria-label="@review.Rating de 5">@stars@emptyStars</div><strong>@review.UserName</strong><small>@review.CreatedAt.ToString("dd/MM/yyyy")</small>@if (!string.IsNullOrWhiteSpace(review.Comment)) { <p>@review.Comment</p> }@if (review.PhotoUrls.Any()) { <div class="bf-review-card__photos">@foreach (var photo in review.PhotoUrls) { <a href="@photo" target="_blank" rel="noopener"><img src="@photo" alt="Foto enviada na avaliação" loading="lazy" /></a> }</div> }</article> }</div> }
</div></section>

@if (relatedProducts.Any()) { <section class="bf-section bf-section--soft"><div class="bf-container"><div class="bf-section__head"><div><span class="bf-eyebrow bf-eyebrow--dark">Você também pode gostar</span><h2>Produtos relacionados</h2></div></div><div class="bf-product-grid">@foreach (var related in relatedProducts) { var relatedImages = related.ImageUrls?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? new List<string>(); if (relatedImages.Count == 0 && !string.IsNullOrWhiteSpace(related.ImageUrl)) relatedImages.Add(related.ImageUrl!); <a class="bf-product-card" asp-controller="Catalog" asp-action="Details" asp-route-id="@related.Id"><div class="bf-product-card__media bf-product-card__media--carousel" data-product-carousel><div class="bf-product-card__slides">@foreach (var img in relatedImages) { <img src="@img" alt="@related.Name" loading="lazy" decoding="async" /> }</div></div><div class="bf-product-card__body"><span class="bf-product-card__cat">@related.CategoryName</span><strong>@related.Name</strong><span class="bf-product-card__price">@related.Price.ToString("C")</span></div></a> }</div></div></section> }

<div class="bf-product-lightbox" data-product-lightbox aria-hidden="true">
    <div class="bf-product-lightbox__backdrop" data-lightbox-close></div>
    <div class="bf-product-lightbox__panel" role="dialog" aria-modal="true" aria-label="Fotos de @Model?.Name">
        <button type="button" class="bf-product-lightbox__close" data-lightbox-close aria-label="Fechar">×</button>
        <div class="bf-product-lightbox__image-wrap" data-lightbox-zoom-area>
            <img src="@images.FirstOrDefault()" alt="@Model?.Name" data-lightbox-image />
            <div class="bf-product-lightbox__lens" data-lightbox-lens aria-hidden="true"></div>
            <button type="button" class="bf-product-lightbox__zoom" data-lightbox-zoom aria-label="Ativar lupa para ver os detalhes" aria-pressed="false">⌕ <span>Lupa</span></button>
        </div>
        <div class="bf-product-lightbox__controls"><button type="button" data-lightbox-previous aria-label="Foto anterior">‹</button><span data-lightbox-count>1 / @images.Count</span><button type="button" data-lightbox-next aria-label="Próxima foto">›</button></div>
        <div class="bf-product-lightbox__thumbs">@for (var index = 0; index < images.Count; index++) { <button type="button" data-lightbox-select="@index" aria-label="Ver foto @(index + 1)"><img src="@images[index]" alt="Miniatura de @Model?.Name" /></button> }</div>
    </div>
</div>

@if(requiresSize){<div class="bf-size-guide" data-size-guide aria-hidden="true"><div class="bf-size-guide__backdrop" data-size-guide-close></div><div class="bf-size-guide__panel"><button type="button" data-size-guide-close>×</button><div class="bf-size-guide__visual">@if(images.Any()){<img src="@images[0]" alt="@Model?.Name" />}<strong>Tabela de tamanhos</strong></div><div class="bf-size-guide__content"><p>Selecione um tamanho e compare as medidas aproximadas.</p><div class="bf-size-buttons">@foreach(var size in sizes){<span>@size</span>}</div><dl><div><dt>Comprimento</dt><dd>Consulte a etiqueta da peça</dd></div><div><dt>Tórax / cintura</dt><dd>Medida aproximada</dd></div><div><dt>Caimento</dt><dd>Regular e confortável</dd></div></dl><small>As medidas variam conforme o modelo. Em produção, o administrador poderá cadastrar medidas específicas.</small></div></div></div>}
