@model CatalogViewModel
@{ViewData["Title"]="Catálogo";var apiUnavailable=(bool)(ViewData["ApiUnavailable"]??false);}
@if(apiUnavailable){<div class="bf-container bf-alert-wrap"><div class="bf-alert">O catálogo está temporariamente indisponível.</div></div>}
<section class="bf-page-hero"><div class="bf-container bf-page-hero__inner"><div><span class="bf-eyebrow bf-eyebrow--dark">Coleção Beta Fit</span><h1>Encontre sua próxima peça</h1><p>Use os filtros e abra o produto para escolher cor, tamanho e quantidade.</p></div><div class="bf-page-hero__count"><strong>@Model.TotalCount</strong><span>resultados</span></div></div></section>
<section class="bf-section bf-section--catalog"><div class="bf-container">
        <div class="bf-catalog-toolbar">
            <button class="bf-filter-trigger" type="button" data-filter-open>
                <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="25" height="25" viewBox="0,0,256,256">
                    <g fill="#ffffff" fill-rule="nonzero" stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-weight="none" font-size="none" text-anchor="none" style="mix-blend-mode: normal"><g transform="scale(5.33333,5.33333)"><path d="M20.5,6c-7.98444,0 -14.5,6.51556 -14.5,14.5c0,7.98444 6.51556,14.5 14.5,14.5c3.27316,0 6.28892,-1.10698 8.7207,-2.94922l9.36523,9.36328c0.50163,0.52248 1.24653,0.73295 1.94742,0.55024c0.70088,-0.18271 1.24823,-0.73006 1.43094,-1.43094c0.18271,-0.70088 -0.02776,-1.44578 -0.55024,-1.94742l-9.36328,-9.36523c1.84224,-2.43179 2.94922,-5.44755 2.94922,-8.7207c0,-7.98444 -6.51556,-14.5 -14.5,-14.5zM20.5,10c5.82269,0 10.5,4.67732 10.5,10.5c0,2.79571 -1.08593,5.3206 -2.85156,7.19727c-0.17187,0.12442 -0.32284,0.2754 -0.44727,0.44727c-1.87707,1.76787 -4.40346,2.85547 -7.20117,2.85547c-5.82268,0 -10.5,-4.67732 -10.5,-10.5c0,-5.82268 4.67732,-10.5 10.5,-10.5z"></path></g></g>
                </svg> Filtrar produtos
            </button><span>Mostrando <strong>@Model.Items.Count</strong> de @Model.TotalCount</span><div class="bf-view-switch" aria-label="Modo de visualização"><a class="@(Model.ViewMode == "grid" ? "is-active" : "")" href="?searchTerm=@Model.SearchTerm&categoryId=@Model.CategoryId&gender=@Model.Gender&availability=@Model.Availability&sortBy=@Model.SortBy&viewMode=grid" title="Grade">▦</a><a class="@(Model.ViewMode == "list" ? "is-active" : "")" href="?searchTerm=@Model.SearchTerm&categoryId=@Model.CategoryId&gender=@Model.Gender&availability=@Model.Availability&sortBy=@Model.SortBy&viewMode=list" title="Lista">☷</a></div>
        </div>
<div class="bf-product-grid bf-product-grid--catalog @(Model.ViewMode=="list"?"is-list":"")">@foreach(var product in Model.Items){var image=product.ImageUrl??product.ImageUrls.FirstOrDefault();<article class="bf-product-card bf-product-card--catalog"><a asp-action="Details" asp-route-id="@product.Id"><div class="bf-product-card__media">@if(product.IsFeatured){<span class="bf-product-card__badge">Destaque</span>}@if(product.Stock<=0){<span class="bf-product-card__badge bf-product-card__badge--soldout">Esgotado</span>}@if(!string.IsNullOrWhiteSpace(image)){<img src="@image" alt="@product.Name" loading="lazy" />}else{<div class="bf-product-card__placeholder">BF</div>}</div><div class="bf-product-card__body"><span class="bf-product-card__cat">@product.CategoryName · @product.Gender</span><strong>@product.Name</strong>@if(product.ColorImageUrls.Any()){<span class="bf-variant-thumbs">@foreach(var variant in product.ColorImageUrls.Take(6)){<img src="@variant.Value" title="@variant.Key" alt="@variant.Key" />}</span>}else if(product.AvailableColors.Any()){<span class="bf-product-colors">@foreach(var color in product.AvailableColors.Take(6)){<i class="bf-color-dot" data-color="@color" title="@color"></i>}</span>}<span class="bf-product-card__price">@product.EffectivePrice.ToString("C")</span></div></a></article>}@if(!Model.Items.Any()){<div class="bf-empty"><strong>Nenhum produto encontrado.</strong><span>Ajuste os filtros.</span></div>}</div>
@if(Model.TotalPages>1){<div class="bf-pagination">@for(var i=1;i<=Model.TotalPages;i++){<a class="@(i==Model.Page?"active":"")" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-gender="@Model.Gender" asp-route-availability="@Model.Availability" asp-route-sortBy="@Model.SortBy" asp-route-viewMode="@Model.ViewMode" asp-route-page="@i">@i</a>}</div>}
</div></section>
<div class="bf-filter-drawer" data-filter-drawer aria-hidden="true"><div class="bf-filter-drawer__backdrop" data-filter-close></div><aside class="bf-filter-drawer__panel"><div class="bf-filter-drawer__head"><h2>Filtrar produtos</h2><button type="button" data-filter-close>×</button></div><form method="get"><input type="hidden" name="viewMode" value="@Model.ViewMode" /><label>Pesquisar<input name="searchTerm" value="@Model.SearchTerm" maxlength="100" placeholder="Nome do produto" /></label><fieldset><legend>Disponibilidade</legend><label><input type="radio" name="availability" value="" checked="@(string.IsNullOrEmpty(Model.Availability))" /> Todos</label><label><input type="radio" name="availability" value="in" checked="@(Model.Availability=="in")" /> Em estoque</label><label><input type="radio" name="availability" value="out" checked="@(Model.Availability=="out")" /> Fora de estoque</label></fieldset><label>Categoria<select name="categoryId"><option value="">Todas</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId==c.Id)">@c.Name</option>}</select></label><label>Gênero<select name="gender"><option value="">Todos</option>@foreach(var g in Enum.GetValues<Gender>()){<option value="@g" selected="@(Model.Gender==g)">@g</option>}</select></label><label>Ordenar<select name="sortBy"><option value="">Nome</option><option value="price_asc" selected="@(Model.SortBy=="price_asc")">Menor preço</option><option value="price_desc" selected="@(Model.SortBy=="price_desc")">Maior preço</option><option value="newest" selected="@(Model.SortBy=="newest")">Novidades</option></select></label><div class="bf-filter-drawer__actions"><a asp-action="Index">Limpar tudo</a><button class="bf-btn bf-btn--dark">Aplicar</button></div></form></aside></div>
