@model CatalogViewModel
@{ ViewData["Title"] = "Catálogo"; var apiUnavailable = (bool)(ViewData["ApiUnavailable"] ?? false); }
@if (apiUnavailable) { <div class="bf-container bf-alert-wrap"><div class="bf-alert">O catálogo está temporariamente indisponível.</div></div> }
<section class="bf-page-hero"><div class="bf-container bf-page-hero__inner"><div><span class="bf-eyebrow bf-eyebrow--dark">Coleção Beta Fit</span><h1>Encontre sua próxima peça</h1><p>Use os filtros e abra o produto para escolher cor, tamanho e quantidade.</p></div><div class="bf-page-hero__count"><strong>@Model.TotalCount</strong><span>resultados</span></div></div></section>
<section class="bf-section bf-section--catalog"><div class="bf-container">
    <div class="bf-catalog-toolbar"><button class="bf-filter-trigger" type="button" data-filter-open>☷ Filtrar produtos</button><span>Mostrando <strong>@Model.Items.Count</strong> de @Model.TotalCount</span><div class="bf-view-switch" aria-label="Modo de visualização"><a class="@(Model.ViewMode == "grid" ? "is-active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-gender="@Model.Gender" asp-route-availability="@Model.Availability" asp-route-sortBy="@Model.SortBy" asp-route-minPrice="@Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" asp-route-maxPrice="@Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" asp-route-viewMode="grid">▦</a><a class="@(Model.ViewMode == "list" ? "is-active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-gender="@Model.Gender" asp-route-availability="@Model.Availability" asp-route-sortBy="@Model.SortBy" asp-route-minPrice="@Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" asp-route-maxPrice="@Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" asp-route-viewMode="list">☷</a></div></div>
    <div class="bf-product-grid bf-product-grid--catalog @(Model.ViewMode == "list" ? "is-list" : "")">
    @foreach (var product in Model.Items)
    {
        var image = product.ImageUrls.FirstOrDefault() ?? product.ImageUrl;
        <article class="bf-product-card bf-product-card--catalog"><a href="/Product/@product.Id"><div class="bf-product-card__media">@if (product.IsFeatured) { <span class="bf-product-card__badge">Destaque</span> }@if (product.Stock <= 0) { <span class="bf-product-card__badge bf-product-card__badge--soldout">Esgotado</span> }@if (!string.IsNullOrWhiteSpace(image)) { <img src="@image" alt="@product.Name" loading="lazy" /> } else { <div class="bf-product-card__placeholder">BF</div> }</div><div class="bf-product-card__body"><span class="bf-product-card__cat">@product.CategoryName · @product.Gender</span><strong>@product.Name</strong>@if (product.ColorImageUrls.Any()) { <span class="bf-variant-thumbs">@foreach (var variant in product.ColorImageUrls.Take(6)) { <img src="@variant.Value" title="@variant.Key" alt="@variant.Key" /> }</span> } else if (product.AvailableColors.Any()) { <span class="bf-product-colors">@foreach (var color in product.AvailableColors.Take(6)) { <i class="bf-color-dot" data-color="@color" title="@color"></i> }</span> }@if (product.SalePrice.HasValue) { <del>@product.Price.ToString("C")</del><span class="bf-badge bf-badge--offer">Promoção</span> }<span class="bf-product-card__price">@product.EffectivePrice.ToString("C")</span></div></a></article>
    }
    @if (!Model.Items.Any()) { <div class="bf-empty"><strong>Nenhum produto encontrado.</strong><span>Ajuste os filtros.</span></div> }
    </div>
    @if (Model.TotalPages > 1) {
        var start = ((Model.Page - 1) / 3) * 3 + 1;
        var end = Math.Min(start + 2, Model.TotalPages);
        string PageLink(int number) => Url.Action("Index", "Catalog", new { searchTerm=Model.SearchTerm,categoryId=Model.CategoryId,gender=Model.Gender,availability=Model.Availability,sortBy=Model.SortBy,viewMode=Model.ViewMode,minPrice=Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture),maxPrice=Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture),page=number })!;
        <nav class="bf-pagination bf-pagination--grouped" aria-label="Paginação do catálogo">
        @if(start > 1){<a href="@PageLink(start-3)" aria-label="Três páginas anteriores" class="bf-page-group">‹</a>}
        @for(var i=start;i<=end;i++){<a href="@PageLink(i)" class="@(i==Model.Page?"active":"")" aria-current="@(i==Model.Page?"page":null)">@i</a>}
        @if(end<Model.TotalPages){<a href="@PageLink(start+3)" aria-label="Próximas três páginas" class="bf-page-group">›</a>}
        </nav><p class="bf-page-position">Página @Model.Page de @Model.TotalPages</p>
    }
</div></section>
<div class="bf-filter-drawer" data-filter-drawer aria-hidden="true"><div class="bf-filter-drawer__backdrop" data-filter-close></div><aside class="bf-filter-drawer__panel"><div class="bf-filter-drawer__head"><h2>Filtrar produtos</h2><button type="button" data-filter-close>×</button></div><form method="get"><input type="hidden" name="viewMode" value="@Model.ViewMode" /><label>Pesquisar<input name="searchTerm" value="@Model.SearchTerm" maxlength="100" placeholder="Nome do produto" /></label><label>Categoria<select name="categoryId"><option value="">Todas</option>@foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option> }</select></label><fieldset class="bf-price-filter"><legend>Faixa de preço</legend><div><label>De (R$)<input type="number" name="minPrice" min="0" max="999999" step="0.01" value="@Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="0,00" /></label><label>Até (R$)<input type="number" name="maxPrice" min="0" max="999999" step="0.01" value="@Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="Sem limite" /></label></div><small>Considera o preço promocional, quando houver.</small></fieldset><input type="hidden" name="gender" value="@Model.Gender"/><input type="hidden" name="availability" value="@Model.Availability"/><label>Ordenar<select name="sortBy"><option value="">Nome</option><option value="price_asc" selected="@(Model.SortBy == "price_asc")">Menor preço</option><option value="price_desc" selected="@(Model.SortBy == "price_desc")">Maior preço</option><option value="newest" selected="@(Model.SortBy == "newest")">Novidades</option></select></label><div class="bf-filter-drawer__actions"><a asp-controller="Catalog" asp-action="Index">Limpar tudo</a><button class="bf-btn bf-btn--dark">Aplicar</button></div></form></aside></div>
