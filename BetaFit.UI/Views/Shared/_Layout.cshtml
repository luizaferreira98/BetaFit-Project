@{
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var userName = User?.Identity?.Name;
    var isAdmin = User?.IsInRole("Admin") ?? false;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111111" />
    <title>@ViewData["Title"] - Beta Fit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BetaFit.UI.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="bf-skip-link" href="#main-content">Pular para o conteúdo</a>

    <div class="bf-announcement">
        <div class="bf-container bf-announcement__inner">
            <span>Beta Fit · Performance para quem leva o treino a sério.</span>
            <span class="bf-announcement__right">Projeto demonstrativo · Preços sem venda real</span>
        </div>
    </div>

    <header class="bf-header">
        <div class="bf-container bf-header__inner">
            <a class="bf-logo" asp-controller="Home" asp-action="Index" aria-label="Beta Fit - início">
                BETA<span>FIT</span>
            </a>

            <nav class="bf-nav" aria-label="Navegação principal">
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "is-active" : "")" asp-controller="Home" asp-action="Index">Início</a>
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalog" ? "is-active" : "")" asp-controller="Catalog" asp-action="Index">Catálogo</a>
                @if (isAdmin)
                {
                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "is-active" : "")" asp-controller="Admin" asp-action="Index">Administração</a>
                }
                @if (isAuthenticated)
                {
                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "is-active" : "")" asp-controller="Orders" asp-action="MyOrders">Meus Pedidos</a>
                }
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cart" ? "is-active" : "")" asp-controller="Cart" asp-action="Index">Carrinho</a>
            </nav>

            <div class="bf-header__actions">
                @if (isAuthenticated)
                {
                    <span class="bf-user-chip" title="Usuário conectado">
                        <span class="bf-user-chip__icon" aria-hidden="true">@((userName ?? "U").Substring(0, 1).ToUpper())</span>
                        <span class="bf-user-chip__name">@userName</span>
                    </span>
                    <form class="bf-logout-form" asp-controller="Account" asp-action="Logout" method="post" onsubmit="return confirm('Tem certeza que deseja sair da sua conta?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="bf-icon-link bf-icon-button" title="Sair" aria-label="Sair">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4M15 8l4 4-4 4M19 12H9" /></svg>
                        </button>
                    </form>
                }
                else
                {
                    <a class="bf-account-link" asp-controller="Account" asp-action="Login">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>
                        <span>Entrar</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <main id="main-content">
        @RenderBody()
    </main>

    <footer class="bf-footer">
        <div class="bf-container">
            <div class="bf-footer__main">
                <div class="bf-footer__brand">
                    <a class="bf-logo bf-logo--footer" asp-controller="Home" asp-action="Index">BETA<span>FIT</span></a>
                    <p>Performance, conforto e identidade para quem transforma disciplina em rotina.</p>
                </div>
                <div>
                    <h4>Navegação</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Início</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index">Catálogo</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Carrinho</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Institucional</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacidade</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="sobre">Sobre a Beta Fit</a></li>
                    </ul>
                </div>
                <div class="bf-footer__statement">
                    <span>DISCIPLINA</span>
                    <strong>MOVE<br />FORWARD.</strong>
                </div>
            </div>
            <div class="bf-footer__bottom">
                <span>&copy; @DateTime.Now.Year Beta Fit. Projeto institucional/demonstrativo.</span>
                <span>Feito para quem não para.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (isAuthenticated)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js" integrity="" crossorigin="anonymous"></script>
        <script>
            (function() {
                try {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl('/hubs/orders')
                        .withAutomaticReconnect()
                        .build();

                    connection.on('OrderFinalized', function(payload) {
                        // payload contém { orderId }
                        alert('✅ Seu pedido foi finalizado. Você será redirecionado para Meus Pedidos.');
                        window.location.href = '/Orders/MyOrders';
                    });

                    connection.start().catch(err => console.error('SignalR:', err.toString()));
                } catch (ex) {
                    console.error(ex);
                }
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
