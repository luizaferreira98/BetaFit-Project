@model IEnumerable<ProductDto>
<div class="bf-product-rail" data-product-rail><div class="bf-product-rail__track">@foreach(var p in Model){var img=p.ImageUrls.FirstOrDefault()??p.ImageUrl;<a class="bf-product-card" href="/Product/@p.Id"><div class="bf-product-card__media">@if(!string.IsNullOrWhiteSpace(img)){<img src="@img" alt="@p.Name" loading="lazy" />}@if(p.IsFeatured){<span class="bf-product-card__badge">★ Destaque</span>}@if(p.SalePrice.HasValue){<span class="bf-sale-label">−@Math.Round((1-p.EffectivePrice/p.Price)*100)%</span>}@if(p.Stock<=0){<span class="bf-product-card__badge bf-product-card__badge--soldout">Esgotado</span>}</div><div class="bf-product-card__body"><span class="bf-product-card__cat">@p.CategoryName</span><strong>@p.Name</strong>@if(p.SalePrice.HasValue){<del>@p.Price.ToString("C")</del>}<span class="bf-product-card__price">@p.EffectivePrice.ToString("C")</span></div></a>}</div></div>
