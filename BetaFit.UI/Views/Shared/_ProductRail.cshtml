@model IEnumerable<ProductDto>
<div class="bf-product-rail" data-product-rail><button type="button" data-rail-prev aria-label="Anterior">‹</button><div class="bf-product-rail__track">@foreach(var p in Model){var img=p.ImageUrl??p.ImageUrls.FirstOrDefault();<a class="bf-product-card" asp-controller="Catalog" asp-action="Details" asp-route-id="@p.Id"><div class="bf-product-card__media">@if(!string.IsNullOrWhiteSpace(img)){<img src="@img" alt="@p.Name" loading="lazy" />}@if(p.Stock<=0){<span class="bf-product-card__badge bf-product-card__badge--soldout">Esgotado</span>}</div><div class="bf-product-card__body"><span class="bf-product-card__cat">@p.CategoryName</span><strong>@p.Name</strong>@if(p.SalePrice.HasValue){<del>@p.Price.ToString("C")</del>}<span class="bf-product-card__price">@p.EffectivePrice.ToString("C")</span></div></a>}</div><button type="button" data-rail-next aria-label="Próximo">›</button></div>
