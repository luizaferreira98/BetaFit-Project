@model BetaFit.Application.DTOs.OrderDto
@using System.Globalization
@{ ViewData["Title"] = "Pagamento Pix"; var reference = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes($"betafit-example-{Model.Id}")))[..25]; var amount = Model.Total.ToString("0.00",CultureInfo.InvariantCulture); var payload=$"00020101021226860014br.gov.bcb.pix0136{reference.ToLowerInvariant()}0000000000052040000530398654{amount.Length:00}{amount}5802BR5907BETAFIT6009SAO PAULO62290525{reference}6304DEMO"; var qrUrl=$"https://quickchart.io/qr?size=320&margin=2&text={Uri.EscapeDataString(payload)}"; }
<section class="bf-page-hero bf-page-hero--compact"><div class="bf-container bf-page-hero__inner"><div><span class="bf-eyebrow bf-eyebrow--dark">Pagamento demonstrativo</span><h1>Pague com Pix</h1><p>Escaneie o QR Code de exemplo e confirme a transação para continuar.</p></div></div></section>
<section class="bf-section"><div class="bf-container"><div class="bf-pix-layout">
    <div class="bf-pix-card"><span class="bf-pix-card__step">Pedido #@Model.Id</span><h2>QR Code Pix</h2><img src="@qrUrl" alt="QR Code demonstrativo do pedido @Model.Id" width="320" height="320" referrerpolicy="no-referrer" /><p>Valor: <strong>@Model.Total.ToString("C")</strong></p><label class="bf-pix-copy">Pix copia e cola (exemplo)<textarea id="pix-code" readonly rows="3">@payload</textarea></label><button type="button" class="bf-btn bf-btn--dark" data-copy-pix>Copiar código Pix</button><p role="status" data-copy-status></p><small>Este QR Code contém apenas dados fictícios e não realiza cobrança.</small></div>
    <aside class="bf-pix-instructions"><span class="bf-eyebrow bf-eyebrow--dark">Como testar</span><ol><li>Abra o leitor de QR Code.</li><li>Confira o número e o valor do pedido.</li><li>Volte para esta tela e conclua a simulação.</li></ol><form asp-action="ConfirmPix" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="bf-btn bf-btn--dark bf-btn--wide" type="submit">Transação concluída com sucesso <span>✓</span></button></form><a class="bf-btn bf-btn--ghost bf-btn--wide" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id">Ver pedido</a></aside>
</div></div></section>
