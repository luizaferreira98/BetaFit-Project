@model List<ProductDto>
@{ ViewData["Title"]="Favoritos"; }
<section class="bf-page-hero bf-page-hero--compact"><div class="bf-container bf-page-hero__inner"><div><span class="bf-eyebrow bf-eyebrow--dark">Sua seleção</span><h1>Favoritos</h1><p>Produtos que você marcou para rever depois.</p></div></div></section><section class="bf-section bf-section--catalog"><div class="bf-container">@if(TempData["FavoriteMessage"] is string m){<div class="bf-alert">@m</div>}@if(!Model.Any()){<div class="bf-empty"><strong>Nenhum favorito ainda</strong><span>Abra um produto e clique em adicionar aos favoritos.</span><a class="bf-btn bf-btn--dark" asp-controller="Catalog" asp-action="Index">Explorar catálogo <span>→</span></a></div>}else{<div class="bf-product-grid">@foreach(var p in Model){<article class="bf-product-card"><a asp-controller="Catalog" asp-action="Details" asp-route-id="@p.Id"><div class="bf-product-card__media">@if(!string.IsNullOrWhiteSpace(p.ImageUrl)){<img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />}</div><div class="bf-product-card__body"><span class="bf-product-card__cat">@p.CategoryName</span><strong>@p.Name</strong><span class="bf-product-card__price">@p.Price.ToString("C")</span></div></a><form asp-controller="Favorites" asp-action="Toggle" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id" /><button class="bf-btn bf-btn--outline bf-btn--wide" type="submit">Remover dos favoritos</button></form></article>}</div>}</div></section>
