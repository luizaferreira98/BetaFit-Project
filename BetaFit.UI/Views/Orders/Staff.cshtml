@model IEnumerable<OrderDto>

@{
    ViewData["Title"] = "Pedidos — Equipe";

    var statuses = new[]
    {
        "Pendente",
        "Confirmado",
        "EmPreparacao",
        "Pronto",
        "Enviado",
        "Entregue",
        "Cancelado",
        "Reembolso"
    };

    var selected = ViewData["SelectedStatus"] as string;
    var orders = Model?.ToList() ?? new List<OrderDto>();
}

<section class="bf-section">
    <div class="bf-container">

        <!-- CABEÇALHO -->
        <div class="bf-admin-header">
            <span class="bf-eyebrow bf-eyebrow--dark">
                Operação
            </span>

            <h1>Pedidos</h1>

            <p>
                Selecione vários pedidos, acompanhe pagamentos
                e atualize o andamento.
            </p>
        </div>

        <!-- MENSAGENS -->
        @if (TempData["Success"] is string ok)
        {
            <div class="bf-alert bf-alert--success">
                @ok
            </div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="bf-alert bf-alert--error">
                @error
            </div>
        }

        <!-- FILTROS -->
        <form asp-action="Staff"
              method="get"
              class="bf-admin-filter">

            <select name="status"
                    aria-label="Filtrar pedidos por status">

                <option value="">
                    Todos os pedidos
                </option>

                @foreach (var s in statuses)
                {
                    <option value="@s"
                            selected="@(selected == s)">
                        @s
                    </option>
                }

            </select>

            <button type="submit"
                    class="bf-btn bf-btn--dark">
                Filtrar
            </button>

            <a class="bf-btn bf-btn--ghost"
               asp-action="Staff">
                Limpar
            </a>

        </form>

        <!-- ATUALIZAÇÃO EM LOTE -->
        <form asp-action="BulkStatus"
              method="post"
              data-bulk-form>

            @Html.AntiForgeryToken()

            <div class="bf-bulk-toolbar">

                <label>
                    <input type="checkbox"
                           data-select-all />

                    Selecionar todos
                </label>

                <select name="status"
                        aria-label="Novo status dos pedidos"
                        required>

                    <option value="">
                        Novo status
                    </option>

                    @foreach (var s in statuses)
                    {
                        <option value="@s">
                            @s
                        </option>
                    }

                </select>

                <button type="submit"
                        class="bf-btn bf-btn--dark">
                    Atualizar selecionados
                </button>

                <strong>
                    @orders.Count pedido(s)
                </strong>

            </div>

            <!-- TABELA DE PEDIDOS -->
            <div class="bf-table-scroll">

                <table class="bf-admin-table">

                    <thead>
                        <tr>
                            <th></th>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Itens</th>
                            <th>Total</th>
                            <th>Pagamento</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var o in orders)
                        {
                            <tr>

                                <!-- SELEÇÃO -->
                                <td>
                                    <input type="checkbox"
                                           name="selectedIds"
                                           value="@o.Id"
                                           aria-label="Selecionar pedido @o.Id"
                                           data-select-item />
                                </td>

                                <!-- PEDIDO -->
                                <td>
                                    <strong>
                                        #@o.Id
                                    </strong>

                                    <small>
                                        @o.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </td>

                                <!-- CLIENTE -->
                                <td>
                                    @o.UserName
                                </td>

                                <!-- ITENS -->
                                <td>
                                    @o.Items.Sum(x => x.Quantity)
                                </td>

                                <!-- TOTAL -->
                                <td>
                                    @o.Total.ToString("C")
                                </td>

                                <!-- PAGAMENTO -->
                                <td>
                                    <small>
                                        @o.PaymentMethod
                                        <br />
                                        @o.PaymentStatus
                                    </small>
                                </td>

                                <!-- STATUS -->
                                <td>
                                    <span class="bf-status-pill is-active">
                                        @o.Status
                                    </span>
                                </td>

                                <!-- DETALHES -->
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@o.Id"
                                       asp-route-admin="true">
                                        Detalhes
                                    </a>
                                </td>

                            </tr>
                        }

                        @if (!orders.Any())
                        {
                            <tr>
                                <td colspan="8">
                                    Nenhum pedido encontrado.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </form>

    </div>
</section>