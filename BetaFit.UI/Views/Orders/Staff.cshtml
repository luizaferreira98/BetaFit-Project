@model IEnumerable<OrderDto>
@{ViewData["Title"]="Pedidos — Equipe";var statuses=new[]{"Pendente","Confirmado","EmPreparacao","Pronto","Enviado","Entregue","Cancelado"};var selected=ViewData["SelectedStatus"] as string;}
<section class="bf-page-hero bf-page-hero--compact"><div class="bf-container bf-page-hero__inner"><div><span class="bf-eyebrow bf-eyebrow--dark">Operação</span><h1>Pedidos</h1><p>Selecione vários pedidos, acompanhe pagamentos e atualize o andamento.</p></div></div></section>
<section class="bf-section"><div class="bf-container">@if(TempData["Success"] is string ok){<div class="bf-alert bf-alert--success">@ok</div>}@if(TempData["Error"] is string error){<div class="bf-alert bf-alert--error">@error</div>}<form method="get" class="bf-admin-filter"><select name="status"><option value="">Todos os pedidos</option>@foreach(var s in statuses){<option value="@s" selected="@(selected==s)">@s</option>}</select><button class="bf-btn bf-btn--dark">Filtrar</button><a class="bf-btn bf-btn--ghost" asp-action="Staff">Limpar</a></form>
<form asp-action="BulkStatus" method="post" data-bulk-form>@Html.AntiForgeryToken()<div class="bf-bulk-toolbar"><label><input type="checkbox" data-select-all /> Selecionar todos</label><select name="status" required><option value="">Novo status</option>@foreach(var s in statuses){<option value="@s">@s</option>}</select><button class="bf-btn bf-btn--dark">Atualizar selecionados</button><strong>@Model.Count() pedido(s)</strong></div><div class="bf-table-scroll"><table class="bf-admin-table"><thead><tr><th></th><th>Pedido</th><th>Cliente</th><th>Itens</th><th>Total</th><th>Pagamento</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td><input type="checkbox" name="selectedIds" value="@o.Id" data-select-item /></td><td><strong>#@o.Id</strong><small>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></td><td>@o.UserName</td><td>@o.Items.Sum(x=>x.Quantity)</td><td>@o.Total.ToString("C")</td><td><small>@o.PaymentMethod<br />@o.PaymentStatus</small></td><td><span class="bf-status-pill is-active">@o.Status</span></td><td><a asp-action="Details" asp-route-id="@o.Id" asp-route-admin="true">Detalhes</a></td></tr>}@if(!Model.Any()){<tr><td colspan="8">Nenhum pedido encontrado.</td></tr>}</tbody></table></div></form></div></section>
