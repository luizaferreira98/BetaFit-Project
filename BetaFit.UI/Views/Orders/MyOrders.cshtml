@model IEnumerable<BetaFit.Application.DTOs.OrderDto>
@{
    ViewData["Title"] = "Meus Pedidos";
}

<section class="bf-section">
    <div class="bf-container">
        <h1>Meus Pedidos</h1>

        @if (!Model.Any())
        {
            <div class="bf-empty">
                <div class="bf-empty__icon">⌕</div>
                <strong>Você ainda não possui pedidos</strong>
                <span>Explore nosso catálogo e faça seu primeiro pedido.</span>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var pedido in Model.OrderByDescending(p => p.CreatedAt))
                {
                    <div class="col-md-6 mb-4">
                        <div class="bf-order-card card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h5 class="mb-0">Pedido #@pedido.Id</h5>
                                        <small class="text-muted">@pedido.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                    <div>
                                        <span class="badge bg-secondary">@pedido.Status</span>
                                    </div>
                                </div>

                                <p class="mt-3 mb-2">Total: <strong>@pedido.Total.ToString("C")</strong></p>

                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <a class="bf-btn bf-btn--dark btn btn-sm" asp-controller="Orders" asp-action="Details" asp-route-id="@pedido.Id">Ver detalhes</a>
                                    <a class="bf-btn btn btn-sm btn-outline-secondary" href="/Catalog/Index">Continuar comprando</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
