@model List<UsuarioDto>
@{ViewData["Title"]="Usuários e equipe";}
<section class="bf-section"><div class="bf-container"><span class="bf-eyebrow bf-eyebrow--dark">Administração</span><h1>Usuários e equipe</h1>
@if(TempData["Success"] is string ok){<div class="bf-alert" role="status">@ok</div>}@if(TempData["Error"] is string error){<div class="bf-alert bf-alert--error">@error</div>}
<details class="bf-profile-editor"><summary>Criar usuário</summary><form asp-action="Create" method="post" class="bf-form">@Html.AntiForgeryToken()<div class="bf-form-grid"><label>Nome<input name="UserName" required maxlength="120" /></label><label>E-mail<input name="Email" type="email" required maxlength="256" /></label><label>Perfil de acesso<select name="Role"><option value="Usuario">Cliente</option><option value="Funcionario">Funcionário</option><option value="Admin">Administrador</option></select></label><label>Senha inicial<input name="Password" type="password" minlength="6" maxlength="100" required /></label><label>Confirmar senha<input name="ConfirmPassword" type="password" minlength="6" maxlength="100" required /></label></div><button class="bf-btn bf-btn--dark">Criar usuário</button></form></details>
<div class="bf-moderation-list">@foreach(var user in Model){<article class="bf-review-card"><strong>@user.UserName</strong><p>@user.Email · @string.Join(", ",user.Roles)</p>@if(user.Id!=User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value){<details><summary>Editar acesso</summary><form asp-action="Update" asp-route-id="@user.Id" method="post" class="bf-form">@Html.AntiForgeryToken()<label>E-mail<input name="Email" type="email" value="@user.Email" required /></label><label>Perfil de acesso<select name="Role">@foreach(var role in new[]{"Usuario","Funcionario","Admin"}){<option selected="@user.Roles.Contains(role)" value="@role">@role</option>}</select></label><button class="bf-btn bf-btn--dark">Salvar</button></form></details><form asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Excluir este usuário? Esta ação não pode ser desfeita.');">@Html.AntiForgeryToken()<button class="bf-btn bf-btn--ghost">Excluir usuário</button></form>}else{<a asp-controller="Account" asp-action="Profile">Minha conta</a>}</article>}</div></div></section>
