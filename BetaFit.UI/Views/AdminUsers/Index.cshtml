@model List<UsuarioDto>
@{ViewData["Title"]="Usuários e equipe";var list=ViewData["List"]?.ToString();}
<section class="bf-section"><div class="bf-container"><span class="bf-eyebrow bf-eyebrow--dark">Administração</span><h1>Usuários e equipe</h1>
<nav class="bf-tabs"><a class="@(list!="team"?"is-active":"")" href="/Admin/Users?list=customers">Clientes (@ViewData["Customers"])</a><a class="@(list=="team"?"is-active":"")" href="/Admin/Users?list=team">Equipe (@ViewData["Team"])</a></nav>
<p>Cliente: compras e perfil. Estoquista: compras, produtos, estoque, categorias e status dos pedidos. Administrador: acesso completo.</p>
@if(TempData["Success"] is string ok){<div class="bf-alert" role="status">@ok</div>}@if(TempData["Error"] is string error){<div class="bf-alert bf-alert--error">@error</div>}
<form method="get" class="bf-form bf-toolbar"><input type="hidden" name="list" value="@list"/><input name="search" value="@ViewData["Search"]" placeholder="Buscar nome ou e-mail"/><button class="bf-btn bf-btn--dark">Buscar</button></form>
<details class="bf-profile-editor"><summary>Criar usuário</summary><form asp-action="Create" method="post" class="bf-form">@Html.AntiForgeryToken()<div class="bf-form-grid"><label>Nome<input name="UserName" required maxlength="120" /></label><label>E-mail<input name="Email" type="email" required maxlength="256" /></label><label>Perfil de acesso<select name="Role"><option value="Usuario">Cliente</option><option value="Estoquista">Estoquista</option><option value="Admin">Administrador</option></select></label><label>Senha inicial<input name="Password" type="password" minlength="6" maxlength="100" required /></label><label>Confirmar senha<input name="ConfirmPassword" type="password" minlength="6" maxlength="100" required /></label></div><button class="bf-btn bf-btn--dark">Criar usuário</button></form></details>
<div class="bf-moderation-list">@foreach(var user in Model){<article class="bf-review-card"><strong>@user.UserName</strong><p>@user.Email · @string.Join(", ",user.Roles.Select(r=>r=="Usuario"?"Cliente":r=="Funcionario"?"Estoquista (legado)":r))</p>@if(user.Id!=User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value){<details><summary>Editar acesso</summary><form asp-action="Update" asp-route-id="@user.Id" method="post" class="bf-form">@Html.AntiForgeryToken()<input name="Email" type="hidden" value="@user.Email"/><p>Somente o titular altera o e-mail em Meu perfil, após confirmar o código.</p><label>Perfil de acesso<select name="Role">@foreach(var role in new[]{"Usuario","Estoquista","Admin"}){<option selected="@(user.Roles.Contains(role)||role=="Estoquista"&&user.Roles.Contains("Funcionario"))" value="@role">@(role=="Usuario"?"Cliente":role)</option>}</select></label><button class="bf-btn bf-btn--dark">Salvar acesso</button></form></details><form asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Excluir este usuário?');">@Html.AntiForgeryToken()<button class="bf-btn bf-btn--danger">Excluir usuário</button></form>}else{<a href="/Account/Profile">Minha conta</a>}</article>}</div></div></section>
