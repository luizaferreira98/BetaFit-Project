@model BetaFit.Application.ViewModels.ProductFormViewModel
@using System.Text.Json
@using BetaFit.UI.Helpers
@{var measures=Model.SizeMeasurements.Count>0?Model.SizeMeasurements:ProductMeasurements.For(new ProductDto{AvailableSizes=Model.AvailableSizes,CategoryName=Model.Categories.FirstOrDefault(x=>x.Id==Model.CategoryId)?.Name??""});}
<section class="bf-form-section"><h3>Galerias por cor</h3><p>Adicione todas as fotos de cada cor na ordem de exibição. A primeira será a capa da variação.</p><div class="bf-color-image-admin__grid">
@foreach(var item in new[]{("Preto","preto"),("Branco","branco"),("Cinza","cinza"),("Azul","azul"),("Verde neon","verdeneon"),("Rosa","rosa"),("Vermelho","vermelho"),("Bege","bege")}){<div><strong>@item.Item1</strong>@if(Model.ColorGalleries.TryGetValue(item.Item1,out var urls)){@foreach(var url in urls){<label><img src="@url" alt="@item.Item1" width="60"/><input type="checkbox" name="keepGallery_@item.Item2" value="@url" checked /> Manter</label>}}<input type="file" name="colorGallery_@item.Item2" accept="image/jpeg,image/png,image/webp" multiple /></div>}
</div></section>
<section class="bf-form-section"><h3>Tabela de medidas por tamanho</h3><p>Preencha as medidas em centímetros para cada tamanho selecionado. Clique no valor para editar.</p><input type="hidden" name="measurementsJson" data-measure-editor-value value="@(Context.Request.HasFormContentType?Context.Request.Form["measurementsJson"].ToString():JsonSerializer.Serialize(measures))" /><div class="bf-table-scroll" data-measure-editor></div><label class="bf-check"><input asp-for="MeasurementsAreDemo" /><span>Medidas de demonstração (desmarque somente após conferir as peças)</span></label></section>
