@model SiteSettingsDto
@{ ViewData["Title"]="Personalização do site"; while(Model.HeroSlides.Count<3) Model.HeroSlides.Add(new HeroSlideDto()); while(Model.HeaderLinks.Count<4) Model.HeaderLinks.Add(new HeaderLinkDto()); }
<section class="bf-page-hero bf-page-hero--admin"><div class="bf-container bf-page-hero__inner"><div><span class="bf-eyebrow bf-eyebrow--dark">Autonomia administrativa</span><h1>Header, eventos e carrossel</h1><p>Edite a faixa superior, links especiais e imagens ou vídeos do primeiro container.</p></div></div></section>
<section class="bf-section"><div class="bf-container bf-form-page">@if(TempData["Success"] is string ok){<div class="bf-alert bf-alert--success">@ok</div>}<form method="post" enctype="multipart/form-data" class="bf-form bf-form--admin">@Html.AntiForgeryToken()
<div class="bf-form-section"><div class="bf-form-section__head"><span>01</span><div><strong>Faixa do header</strong><small>Mensagem promocional exibida no topo.</small></div></div><label>Mensagem<input asp-for="Announcement" maxlength="160" /></label></div>
<div class="bf-form-section"><div class="bf-form-section__head"><span>02</span><div><strong>Links e eventos especiais</strong><small>Use URLs internas, como /Catalog?categoryId=2, ou externas.</small></div></div>@for(var i=0;i<Model.HeaderLinks.Count;i++){<div class="bf-form-grid"><label>Nome<input asp-for="HeaderLinks[i].Label" maxlength="40" placeholder="Ex.: Semana da Corrida" /></label><label>Destino<input asp-for="HeaderLinks[i].Url" maxlength="300" placeholder="/Catalog" /></label></div>}</div>
<div class="bf-form-section"><div class="bf-form-section__head"><span>03</span><div><strong>Slides do destaque principal</strong><small>Até oito slides. Envie imagem ou vídeo; o upload substitui a URL atual.</small></div></div>@for(var i=0;i<Model.HeroSlides.Count;i++){<article class="bf-site-slide"><h3>Slide @(i+1)</h3><input asp-for="HeroSlides[i].MediaUrl" type="hidden" /><input asp-for="HeroSlides[i].MediaType" type="hidden" /><div class="bf-form-grid"><label>Título<input asp-for="HeroSlides[i].Title" maxlength="80" /></label><label>Subtítulo<input asp-for="HeroSlides[i].Subtitle" maxlength="180" /></label><label>Texto do botão<input asp-for="HeroSlides[i].ButtonText" maxlength="40" /></label><label>Destino do botão<input asp-for="HeroSlides[i].ButtonUrl" maxlength="300" /></label><label class="bf-form-grid__full">Wallpaper ou vídeo<input type="file" name="heroMedia_@i" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm" /></label>@if(!string.IsNullOrWhiteSpace(Model.HeroSlides[i].MediaUrl)){<small class="bf-form-grid__full">Atual: @Model.HeroSlides[i].MediaUrl</small>}</div></article>}</div>
<div class="bf-form-actions"><a class="bf-btn bf-btn--ghost" asp-action="Index">Voltar</a><button class="bf-btn bf-btn--dark">Salvar personalização</button></div></form></div></section>
