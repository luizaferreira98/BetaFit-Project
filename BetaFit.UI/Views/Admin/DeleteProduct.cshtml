@model ProductDto
@{
    ViewData["Title"] = "Excluir produto";
}
<div class="bf-container bf-admin bf-auth">
    <h1>Excluir produto</h1>
    <p>Tem certeza que deseja excluir o produto abaixo? Esta ação não pode ser desfeita.</p>

    <div class="bf-card" style="max-width:320px;">
        <div class="bf-card__image" style="background-image:url('@(Model.ImageUrl ?? "/images/placeholder.jpg")')"></div>
        <div class="bf-card__body">
            <span class="bf-card__cat">@Model.CategoryName</span>
            <span class="bf-card__name">@Model.Name</span>
            <span class="bf-card__price">@Model.Price.ToString("C")</span>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="DeleteProductConfirmed" asp-route-id="@Model.Id" method="post" style="margin-top:24px;">
        @Html.AntiForgeryToken()
        <button class="bf-btn bf-btn--primary" type="submit">Confirmar exclusão</button>
        <a class="bf-btn bf-btn--outline" asp-controller="Admin" asp-action="Index" style="margin-left:12px;">Cancelar</a>
    </form>
</div>
