@model List<CouponDto>
@{ViewData["Title"]="Cupons de desconto";}
<section class="bf-section"><div class="bf-container"><span class="bf-eyebrow">Administração</span><h1>Cupons de desconto</h1><p>Descontos percentuais com validade, compra mínima e limite de usos. Cada cliente usa um código uma vez, inclusive em pedidos cancelados.</p>
@if(TempData["Error"] is string error){<div class="bf-alert bf-alert--error">@error <a href="/Admin/Coupons">Tentar novamente</a></div>}@if(TempData["Success"] is string ok){<div class="bf-alert">@ok</div>}
@if(ViewData["CouponsUnavailable"] is not true){
<details class="bf-coupon-create" open><summary>Criar cupom</summary><form action="/Admin/Coupons" method="post" class="bf-form">@Html.AntiForgeryToken()<div class="bf-form-grid"><label>Código<input name="Code" required pattern="[A-Za-z0-9_-]{3,40}" maxlength="40" placeholder="BEMVINDO10"/></label><label>Desconto (%)<input name="Percent" type="number" min="0.01" max="100" step="0.01" value="10" required/></label><label>Compra mínima (R$)<input name="Minimum" type="number" min="0" max="999999" step="0.01" value="0" required/></label><label>Válido até (horário local)<input name="ExpiresAt" type="datetime-local" required/></label><label>Máximo de usos<input name="MaxUses" type="number" min="1" max="1000000" value="100" required/></label></div><input name="Active" type="hidden" value="true"/><button class="bf-btn bf-btn--dark">Criar cupom</button></form></details>
<div class="bf-table-scroll"><table class="bf-admin-table"><thead><tr><th>Código</th><th>Desconto</th><th>Mínimo</th><th>Validade</th><th>Usos</th><th>Ação</th></tr></thead><tbody>@foreach(var c in Model){<tr><td><strong>@c.Code</strong><small>@(c.Active && c.ExpiresAt > DateTime.UtcNow && c.Used < c.MaxUses ? "Ativo" : "Desativado")</small></td><td>@c.Percent%</td><td>@c.Minimum.ToString("C")</td><td>@DateTime.SpecifyKind(c.ExpiresAt,DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@c.Used / @c.MaxUses</td><td><form action="/Admin/Coupons/@c.Id/Toggle" method="post">@Html.AntiForgeryToken()<button class="bf-btn bf-btn--ghost" disabled="@(c.ExpiresAt <= DateTime.UtcNow || c.Used >= c.MaxUses)">@(c.ExpiresAt <= DateTime.UtcNow ? "Expirado" : c.Used >= c.MaxUses ? "Limite atingido" : c.Active ? "Desativar" : "Ativar")</button></form></td></tr>}</tbody></table></div>
}
</div></section>
