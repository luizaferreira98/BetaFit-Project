@model ProductFormViewModel
@{
    ViewData["Title"] = "Editar produto";
    var currentGender = (Gender)(ViewData["Gender"] ?? Gender.Unissex);
}
<section class="bf-page-hero bf-page-hero--compact">
    <div class="bf-container bf-page-hero__inner"><div><span class="bf-eyebrow bf-eyebrow--dark">Administração</span><h1>Editar produto</h1><p>Atualize os dados desta peça.</p></div></div>
</section>
<section class="bf-section bf-section--catalog">
    <div class="bf-container bf-form-page">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bf-alert bf-alert--error" role="alert">@Html.ValidationSummary(true, "", new { @class = "bf-validation" })</div>
        }
        <form asp-controller="Admin" asp-action="EditProduct" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="bf-form bf-form--admin">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ImageUrl" />
            <div class="bf-edit-preview bf-edit-preview--with-upload">
                <div class="bf-current-image">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" />
                    }
                    else
                    {
                        <div>BF</div>
                    }
                    <span>Imagem atual</span>
                </div>
                <div id="product-image-preview" class="bf-image-upload-preview bf-image-upload-preview--compact" data-empty="true" aria-live="polite">
                    <div class="bf-image-upload-preview__placeholder">
                        <span class="bf-image-upload-preview__icon">+</span>
                        <strong>Nova imagem</strong>
                        <span>Escolha um arquivo para visualizar</span>
                    </div>
                    <img class="bf-image-upload-preview__image" alt="Pré-visualização da nova imagem do produto" hidden />
                    <div class="bf-image-upload-preview__meta" hidden>
                        <strong class="bf-image-upload-preview__name"></strong>
                        <span class="bf-image-upload-preview__size"></span>
                    </div>
                </div>
            </div>
            <div class="bf-form-grid">
                <label>Nome<input asp-for="Name" required /></label>
                <label>Preço<input asp-for="Price" type="number" step="0.01" required /></label>
                <label>Categoria<select name="CategoryId" required>@foreach (var category in Model.Categories){<option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>}</select></label>
                <label>Gênero<select name="gender">@foreach (Gender g in Enum.GetValues<Gender>()){<option value="@g" selected="@(g == currentGender)">@g</option>}</select></label>
                <label class="bf-form-grid__full">Descrição<textarea asp-for="Description"></textarea></label>
                <label class="bf-file-field bf-form-grid__full">
                    <span>Nova imagem (opcional)</span>
                    <input id="product-image-input" name="image" type="file" accept="image/png,image/jpeg,image/webp" data-image-preview-input="product-image-preview" />
                    <small>JPG, PNG ou WEBP. A pré-visualização acima mostra a nova imagem antes de salvar.</small>
                </label>
            </div>
            <div class="bf-checks"><label class="bf-check"><input asp-for="IsFeatured" type="checkbox" /><span>Produto em destaque</span></label><label class="bf-check"><input asp-for="IsActive" type="checkbox" /><span>Produto ativo no catálogo</span></label></div>
            <div class="bf-form-actions"><a class="bf-btn bf-btn--ghost" asp-controller="Admin" asp-action="Index">Cancelar</a><button class="bf-btn bf-btn--dark" type="submit">Salvar alterações <span>→</span></button></div>
        </form>
    </div>
</section>
