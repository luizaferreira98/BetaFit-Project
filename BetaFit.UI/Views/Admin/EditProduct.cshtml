@model ProductFormViewModel
@{
    ViewData["Title"] = "Editar produto";
    var currentGender = (Gender)(ViewData["Gender"] ?? Gender.Unissex);
}
<div class="bf-container bf-admin bf-auth">
    <h1>Editar produto</h1>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning">@Html.ValidationSummary(true, "", new { @class = "text-danger" })</div>
    }
    <form asp-controller="Admin" asp-action="EditProduct" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="bf-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ImageUrl" />
        <label>Nome<input asp-for="Name" required /></label>
        <label>Descrição<textarea asp-for="Description"></textarea></label>
        <label>Preço<input asp-for="Price" type="number" step="0.01" required /></label>
        <label>
            Categoria
            <select name="CategoryId" required>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
                }
            </select>
        </label>
        <label>
            Gênero
            <select name="gender">
                @foreach (Gender g in Enum.GetValues<Gender>())
                {
                    <option value="@g" selected="@(g == currentGender)">@g</option>
                }
            </select>
        </label>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="bf-card__image" style="background-image:url('@Model.ImageUrl'); height:160px; margin-bottom:8px;"></div>
        }
        <label>Nova imagem (opcional)<input name="image" type="file" accept="image/png,image/jpeg,image/webp" /></label>
        <label><input asp-for="IsFeatured" type="checkbox" /> Produto em destaque</label>
        <label><input asp-for="IsActive" type="checkbox" /> Produto ativo no catálogo</label>
        <button class="bf-btn bf-btn--primary" type="submit">Salvar alterações</button>
    </form>
</div>
