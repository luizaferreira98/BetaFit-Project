@model List<CategoryDto>
@{ViewData["Title"]="Categorias";var all=ViewData["AllCategories"] as List<CategoryDto>??new();}
<section class="bf-section"><div class="bf-container"><h1>Categorias</h1><p>Organize o menu e acompanhe reposições. Ocultar sem estoque preserva o cadastro e volta a exibir a categoria quando há reposição.</p>
@if(TempData["Success"] is string ok){<p class="bf-alert">@ok</p>}@if(TempData["Error"] is string err){<p class="bf-alert bf-alert--error">@err</p>}
<form class="bf-form bf-toolbar" method="get"><input name="search" value="@ViewData["Search"]" placeholder="Buscar categoria"/><select name="status"><option value="">Todos os status</option>@foreach(var s in new[]{("active","Ativas"),("inactive","Inativas"),("out","Sem estoque")}){<option value="@s.Item1" selected="@(ViewData["SelectedStatus"]?.ToString()==s.Item1)">@s.Item2</option>}</select><button class="bf-btn bf-btn--dark">Filtrar</button><a href="/Admin/Categories">Limpar</a></form>
<details class="bf-profile-editor"><summary>+ Nova categoria</summary><form action="/Admin/Categories/Create" method="post" class="bf-form">@Html.AntiForgeryToken()<label>Nome<input name="Name" required minlength="2" maxlength="100"/></label><label>Slug<input name="Slug" placeholder="acessorios"/></label><label>Categoria pai<select name="ParentId"><option value="">Principal</option>@foreach(var c in all){<option value="@c.Id">@c.Name</option>}</select></label><input name="IsActive" value="true" type="hidden"/><input name="HideWhenOutOfStock" value="true" type="hidden"/><button class="bf-btn bf-btn--dark">Criar categoria</button></form></details>
<form id="category-bulk" action="/Admin/Categories/Bulk" method="post">@Html.AntiForgeryToken()<div class="bf-toolbar"><select name="action"><option value="activate">Ativar selecionadas</option><option value="deactivate">Desativar selecionadas</option><option value="delete">Excluir selecionadas</option></select><button class="bf-btn bf-btn--ghost" onclick="return confirm('Aplicar ação às categorias selecionadas?')">Aplicar</button></div></form><p data-management-feedback role="status"></p><p>Arraste pelo símbolo ↕ para reordenar. As setas também funcionam por teclado. Limpe os filtros para alterar a ordem.</p>
<div data-category-sort data-sort-enabled="@(Model.Count==all.Count?"true":"false")">@foreach(var c in Model){<article class="bf-category-row" data-category-id="@c.Id"><header class="bf-toolbar"><div><span draggable="true" data-category-handle title="Arrastar categoria">↕</span><button type="button" data-category-up aria-label="Mover @c.Name para cima">↑</button><button type="button" data-category-down aria-label="Mover @c.Name para baixo">↓</button><input type="checkbox" form="category-bulk" name="selectedIds" value="@c.Id" aria-label="Selecionar @c.Name"/> <strong>@(c.ParentName==null?c.Name:c.ParentName+" > "+c.Name)</strong></div><label class="bf-toggle"><input type="checkbox" checked="@c.IsActive" data-category-toggle="@c.Id" aria-label="Ativar @c.Name"/><span></span></label></header><div class="bf-category-metrics"><span>@c.TotalStock itens em estoque</span><span>@c.ActiveProducts ativos / @c.InactiveProducts inativos / @c.OutOfStockProducts esgotados</span><span>@c.MonthSales unidades vendidas no mês</span><span class="bf-status-tag @(c.IsVisible?"is-active":"is-inactive")">@(c.IsVisible?"No catálogo":"Oculta no catálogo")</span></div>
<details><summary>Editar nome, URL e regras</summary><form action="/Admin/Categories/@c.Id/Update" method="post" class="bf-form">@Html.AntiForgeryToken()<div class="bf-form-grid"><label>Nome<input name="Name" value="@c.Name" minlength="2" maxlength="100" required/></label><label>Slug / URL amigável<input name="Slug" value="@c.Slug" required maxlength="100"/><small>/categoria/@c.Slug</small></label><label>Categoria pai<select name="ParentId"><option value="">Principal</option>@foreach(var parent in all.Where(x=>x.Id!=c.Id)){<option selected="@(c.ParentId==parent.Id)" value="@parent.Id">@parent.Name</option>}</select></label></div><input type="hidden" name="SortOrder" value="@c.SortOrder"/><input type="hidden" name="IsActive" value="@c.IsActive.ToString().ToLowerInvariant()"/><label class="bf-check"><input type="checkbox" name="HideWhenOutOfStock" value="true" checked="@c.HideWhenOutOfStock"/> Ocultar automaticamente do menu se o estoque zerar</label><input type="hidden" name="HideWhenOutOfStock" value="false"/><button class="bf-btn bf-btn--dark">Salvar regras</button></form></details></article>}</div></div></section>
