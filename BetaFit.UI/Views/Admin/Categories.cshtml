@model IReadOnlyList<BetaFit.Application.DTOs.CategoryDto>
@{ ViewData["Title"]="Categorias"; }
<section class="bf-page-hero bf-page-hero--compact"><div class="bf-container bf-page-hero__inner"><div><span class="bf-eyebrow bf-eyebrow--dark">Catálogo</span><h1>Categorias</h1><p>Crie, edite, ative ou exclua categorias sem sair do painel.</p></div><a class="bf-btn bf-btn--ghost" asp-action="Index">Voltar aos produtos</a></div></section>
<section class="bf-section"><div class="bf-container">
@if(TempData["Success"] is string ok){<div class="bf-alert" role="status">@ok</div>}@if(TempData["Error"] is string error){<div class="bf-alert bf-alert--error" role="alert">@error</div>}
<form asp-action="CreateCategory" method="post" class="bf-category-create bf-form">@Html.AntiForgeryToken()<label>Nova categoria<input name="name" maxlength="100" minlength="2" placeholder="Ex.: Jaquetas" required /></label><button class="bf-btn bf-btn--dark" type="submit">Criar categoria</button></form>
<div class="bf-category-admin-list">@foreach(var category in Model){<article class="bf-category-admin-row"><div><span>@category.ProductCount produto(s)</span><strong>@category.Name</strong><small>@(category.IsActive?"Ativa no catálogo":"Inativa")</small></div><form asp-action="UpdateCategory" asp-route-id="@category.Id" method="post" class="bf-category-inline-form">@Html.AntiForgeryToken()<input name="name" value="@category.Name" maxlength="100" minlength="2" required /><label class="bf-check"><input name="isActive" value="true" type="checkbox" checked="@category.IsActive" /><span>Ativa</span></label><button class="bf-btn bf-btn--outline" type="submit">Salvar</button></form><form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post" onsubmit="return confirm('Excluir esta categoria?');">@Html.AntiForgeryToken()<button class="bf-btn bf-btn--danger" type="submit" disabled="@(category.ProductCount>0)">Excluir</button></form></article>}@if(!Model.Any()){<div class="bf-empty"><strong>Nenhuma categoria cadastrada.</strong></div>}</div>
</div></section>
