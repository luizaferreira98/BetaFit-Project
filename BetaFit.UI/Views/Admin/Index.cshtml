@model List<ProductDto>
@using System.Globalization
@{
    ViewData["Title"] = "Administração";
    var dashboard = ViewData["Dashboard"] as DashboardDto ?? new DashboardDto();
    var categories = ViewData["Categories"] as IEnumerable<CategoryDto> ?? Array.Empty<CategoryDto>();
    var search = ViewData["Search"] as string;
    var selectedCategory = ViewData["SelectedCategoryId"] as int?;
    var selectedStatus = ViewData["SelectedStatus"] as string;
    var maxRevenue = dashboard.SalesByMonth.Any() ? Math.Max(1m, dashboard.SalesByMonth.Max(x => x.Revenue)) : 1m;
}
<section class="bf-page-hero bf-page-hero--admin">
    <div class="bf-container bf-page-hero__inner">
        <div><span class="bf-eyebrow bf-eyebrow--dark">Backoffice Beta Fit</span><h1>Visão geral da operação</h1><p>Acompanhe catálogo, pedidos, faturamento e estoque com dados reais do sistema.</p></div>
        <div class="bf-hero-actions">@if(User.IsInRole("Admin")){<a class="bf-btn bf-btn--outline" asp-action="Site">Editar site</a>}<a class="bf-btn bf-btn--outline" asp-action="Categories">Categorias</a><a class="bf-btn bf-btn--lime" asp-action="NewProduct">+ Novo produto</a></div>
    </div>
</section>
<section class="bf-section bf-section--catalog"><div class="bf-container">
@if(TempData["Success"] is string ok){<div class="bf-alert bf-alert--success" role="status">@ok</div>}
@if(TempData["Error"] is string error){<div class="bf-alert bf-alert--error" role="alert">@error</div>}

<div class="bf-dashboard-grid" aria-label="Indicadores do negócio">
    <article class="bf-dashboard-card"><span>Faturamento</span><strong>@dashboard.TotalRevenue.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</strong><small>Pedidos não cancelados</small></article>
    <article class="bf-dashboard-card"><span>Pedidos</span><strong>@dashboard.TotalOrders</strong><small>@dashboard.PendingOrders pendente(s)</small></article>
    <article class="bf-dashboard-card"><span>Clientes</span><strong>@dashboard.TotalCustomers</strong><small>Clientes com pedidos</small></article>
    <article class="bf-dashboard-card"><span>Estoque crítico</span><strong>@dashboard.OutOfStockProducts</strong><small>Produto(s) esgotado(s)</small></article>
    <article class="bf-dashboard-card"><span>Ticket médio</span><strong>@dashboard.AverageOrderValue.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</strong><small>Valor médio por pedido</small></article>
    <article class="bf-dashboard-card"><span>Produtos ativos</span><strong>@dashboard.ActiveProducts</strong><small>@dashboard.FeaturedProducts destaque(s)</small></article>
</div>

<div class="bf-dashboard-panels">
    <section class="bf-dashboard-panel"><div class="bf-dashboard-panel__head"><div><span class="bf-eyebrow bf-eyebrow--dark">Desempenho</span><h2>Faturamento dos últimos 6 meses</h2></div><span class="bf-dashboard-panel__meta">Dados da operação</span></div>
    <div class="bf-chart" role="img" aria-label="Gráfico de faturamento dos últimos seis meses">
      @foreach(var month in dashboard.SalesByMonth){var height=Math.Max(4m,(month.Revenue/maxRevenue)*100m);<div class="bf-chart__item"><div class="bf-chart__value">@month.Revenue.ToString("C0", CultureInfo.GetCultureInfo("pt-BR"))</div><div class="bf-chart__bar-wrap"><div class="bf-chart__bar" style="height:@height.ToString("0")%" title="@month.Label: @month.Revenue.ToString("C")"></div></div><strong>@month.Label</strong><small>@month.Orders pedido(s)</small></div>}
    </div></section>

    <section class="bf-dashboard-panel"><div class="bf-dashboard-panel__head"><div><span class="bf-eyebrow bf-eyebrow--dark">Pedidos</span><h2>Status atual</h2></div></div>
      <div class="bf-status-chart">@foreach(var status in dashboard.OrdersByStatus){var pct=dashboard.TotalOrders==0?0:(status.Count*100.0/dashboard.TotalOrders);<div class="bf-status-row"><div><span>@status.Status</span><strong>@status.Count</strong></div><div class="bf-status-track"><span style="width:@pct.ToString("0")%"></span></div></div>}@if(!dashboard.OrdersByStatus.Any()){<div class="bf-empty"><strong>Nenhum pedido registrado ainda.</strong><span>Os indicadores aparecerão aqui conforme a operação receber pedidos.</span></div>}</div>
    </section>
</div>

<div class="bf-dashboard-panel bf-dashboard-panel--recent"><div class="bf-dashboard-panel__head"><div><span class="bf-eyebrow bf-eyebrow--dark">Catálogo</span><h2>Produtos recentes</h2></div><span class="bf-dashboard-panel__meta">@dashboard.TotalProducts produto(s) no catálogo · @dashboard.TotalCategories categoria(s)</span></div><div class="bf-recent-products">@foreach(var p in dashboard.RecentProducts){<a class="bf-recent-product" asp-action="EditProduct" asp-route-id="@p.Id">@if(!string.IsNullOrWhiteSpace(p.ImageUrl)){<img src="@p.ImageUrl" alt="" loading="lazy" />}<div><strong>@p.Name</strong><span>@p.CategoryName</span></div><b>@p.Price.ToString("C")</b></a>}@if(!dashboard.RecentProducts.Any()){<div class="bf-empty"><strong>Nenhum produto cadastrado.</strong></div>}</div></div>

<form method="get" class="bf-admin-filter bf-admin-filter--search" data-busy-form>
<input name="search" value="@search" maxlength="100" placeholder="Pesquisar por nome ou descrição" aria-label="Pesquisar produtos" /><select name="categoryId" aria-label="Categoria"><option value="">Todas as categorias</option>@foreach(var c in categories){<option value="@c.Id" selected="@(selectedCategory==c.Id)">@c.Name</option>}</select><select name="status" aria-label="Status"><option value="">Todos os status</option><option value="active" selected="@(selectedStatus=="active")">Ativos</option><option value="inactive" selected="@(selectedStatus=="inactive")">Inativos</option><option value="out" selected="@(selectedStatus=="out")">Esgotados</option></select><button class="bf-btn bf-btn--dark" type="submit">Pesquisar</button><a class="bf-btn bf-btn--ghost" asp-action="Index">Limpar</a></form>
<form asp-action="BulkProducts" method="post" data-busy-form>@Html.AntiForgeryToken()
<div class="bf-bulk-toolbar"><label><input type="checkbox" data-select-all /> Selecionar todos</label><select name="action" required><option value="">Ação nos selecionados</option><option value="activate">Ativar</option><option value="deactivate">Desativar</option><option value="out">Marcar esgotado</option>@if(User.IsInRole("Admin")){<option value="delete">Excluir</option>}</select><button class="bf-btn bf-btn--dark" type="submit" data-busy-label="Aplicando...">Aplicar</button><strong>@Model.Count produto(s) na busca</strong></div>
<div class="bf-table-scroll"><table class="bf-admin-table"><thead><tr><th></th><th>Produto</th><th>Categoria</th><th>Preço</th><th>Estoque</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><input type="checkbox" name="selectedIds" value="@p.Id" data-select-item /></td><td><div class="bf-table-product">@if(!string.IsNullOrWhiteSpace(p.ImageUrl)){<img src="@p.ImageUrl" alt="" loading="lazy" />}<div><strong>@p.Name</strong><small>@p.Gender · @p.AvailableColors.Count cor(es)</small></div></div></td><td>@p.CategoryName</td><td>@p.Price.ToString("C")</td><td><strong class="@(p.Stock<=0?"is-danger":"")">@p.Stock</strong></td><td><span class="bf-status-pill @(p.IsActive&&p.Stock>0?"is-active":"")">@(p.Stock<=0?"Esgotado":p.IsActive?"Ativo":"Inativo")</span></td><td><div class="bf-table-actions"><a asp-action="EditProduct" asp-route-id="@p.Id">Editar</a><a asp-controller="Catalog" asp-action="Details" asp-route-id="@p.Id">Ver</a>@if(User.IsInRole("Admin")){<a class="is-danger" asp-action="DeleteProduct" asp-route-id="@p.Id">Excluir</a>}</div></td></tr>}@if(!Model.Any()){<tr><td colspan="7"><div class="bf-empty"><strong>Nenhum produto encontrado.</strong><span>Tente remover os filtros ou cadastrar um novo produto.</span></div></td></tr>}</tbody></table></div></form>
</div></section>
