@model List<ProductDto>
@{
    ViewData["Title"]="Administração";
    var dashboard=ViewData["Dashboard"] as DashboardDto;
    var categories=ViewData["Categories"] as IEnumerable<CategoryDto> ?? Array.Empty<CategoryDto>();
    var search=ViewData["Search"] as string;
    var selectedCategory=ViewData["SelectedCategoryId"] as int?;
    var selectedStatus=ViewData["SelectedStatus"] as string;
}
<section class="bf-page-hero bf-page-hero--admin"><div class="bf-container bf-page-hero__inner"><div><span class="bf-eyebrow bf-eyebrow--dark">Backoffice Beta Fit</span><h1>Produtos e estoque</h1><p>Pesquise, selecione e administre o catálogo em uma tabela operacional.</p></div><div class="bf-hero-actions">@if(User.IsInRole("Admin")){<a class="bf-btn bf-btn--outline" asp-action="Site">Editar site e eventos</a>}<a class="bf-btn bf-btn--outline" asp-action="Categories">Categorias</a><a class="bf-btn bf-btn--dark" asp-action="NewProduct">+ Novo produto</a></div></div></section>
<section class="bf-section bf-section--catalog"><div class="bf-container">
@if(TempData["Success"] is string ok){<div class="bf-alert bf-alert--success">@ok</div>}@if(TempData["Error"] is string error){<div class="bf-alert bf-alert--error">@error</div>}
@if(dashboard is not null){<div class="bf-admin-stats"><div><span>Produtos</span><strong>@dashboard.TotalProducts</strong></div><div><span>Categorias</span><strong>@dashboard.TotalCategories</strong></div><div><span>Destaques</span><strong>@dashboard.FeaturedProducts</strong></div><div><span>Ativos</span><strong>@dashboard.ActiveProducts</strong></div></div>}
<form method="get" class="bf-admin-filter bf-admin-filter--search"><input name="search" value="@search" maxlength="100" placeholder="Pesquisar por nome ou descrição" /><select name="categoryId"><option value="">Todas as categorias</option>@foreach(var c in categories){<option value="@c.Id" selected="@(selectedCategory==c.Id)">@c.Name</option>}</select><select name="status"><option value="">Todos os status</option><option value="active" selected="@(selectedStatus=="active")">Ativos</option><option value="inactive" selected="@(selectedStatus=="inactive")">Inativos</option><option value="out" selected="@(selectedStatus=="out")">Esgotados</option></select><button class="bf-btn bf-btn--dark">Pesquisar</button><a class="bf-btn bf-btn--ghost" asp-action="Index">Limpar</a></form>
<form asp-action="BulkProducts" method="post" data-bulk-form>@Html.AntiForgeryToken()
<div class="bf-bulk-toolbar"><label><input type="checkbox" data-select-all /> Selecionar todos</label><select name="action" required><option value="">Ação nos selecionados</option><option value="activate">Ativar</option><option value="deactivate">Desativar</option><option value="out">Marcar esgotado</option>@if(User.IsInRole("Admin")){<option value="delete">Excluir</option>}</select><button class="bf-btn bf-btn--dark" type="submit">Aplicar</button><strong>@Model.Count produto(s)</strong></div>
<div class="bf-table-scroll"><table class="bf-admin-table"><thead><tr><th></th><th>Produto</th><th>Categoria</th><th>Preço</th><th>Estoque</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><input type="checkbox" name="selectedIds" value="@p.Id" data-select-item /></td><td><div class="bf-table-product">@if(!string.IsNullOrWhiteSpace(p.ImageUrl)){<img src="@p.ImageUrl" alt="" />}<div><strong>@p.Name</strong><small>@p.Gender · @p.AvailableColors.Count cor(es)</small></div></div></td><td>@p.CategoryName</td><td>@p.Price.ToString("C")</td><td><strong class="@(p.Stock<=0?"is-danger":"")">@p.Stock</strong></td><td><span class="bf-status-pill @(p.IsActive&&p.Stock>0?"is-active":"")">@(p.Stock<=0?"Esgotado":p.IsActive?"Ativo":"Inativo")</span></td><td><div class="bf-table-actions"><a asp-action="EditProduct" asp-route-id="@p.Id">Editar</a><a asp-controller="Catalog" asp-action="Details" asp-route-id="@p.Id">Ver</a>@if(User.IsInRole("Admin")){<a class="is-danger" asp-action="DeleteProduct" asp-route-id="@p.Id">Excluir</a>}</div></td></tr>}@if(!Model.Any()){<tr><td colspan="7"><div class="bf-empty"><strong>Nenhum produto encontrado.</strong></div></td></tr>}</tbody></table></div>
</form></div></section>
