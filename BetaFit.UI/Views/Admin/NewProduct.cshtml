@model ProductFormViewModel
@{ViewData["Title"]="Novo produto";}<section class="bf-page-hero bf-page-hero--compact"><div class="bf-container bf-page-hero__inner"><div><span class="bf-eyebrow bf-eyebrow--dark">Administração</span><h1>Novo produto</h1><p>Cadastre a peça, tamanhos e várias fotos.</p></div></div></section><section class="bf-section bf-section--catalog"><div class="bf-container bf-form-page">@if(!ViewData.ModelState.IsValid){<div class="bf-alert bf-alert--error">@Html.ValidationSummary(true,"",new{@class="bf-validation"})</div>}<form asp-controller="Admin" asp-action="NewProduct" method="post" enctype="multipart/form-data" class="bf-form bf-form--admin">@Html.AntiForgeryToken()<div class="bf-form-grid"><label>Nome<input asp-for="Name" required /></label><label>Preço<input asp-for="Price" type="number" step="0.01" required /></label><label>Categoria<select asp-for="CategoryId" required><option value="">Selecione...</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select></label><label>Gênero<select name="gender" asp-items="Html.GetEnumSelectList<Gender>()"></select></label><label class="bf-form-grid__full">Descrição<textarea asp-for="Description"></textarea></label></div><div class="bf-size-picker"><span>Tamanhos disponíveis</span><div class="bf-size-options">@foreach(var size in new[]{"PP","P","M","G","GG","XG","36","38","40","42","44","Único"}){<label class="bf-size-option"><input type="checkbox" name="AvailableSizes" value="@size" checked="@(Model.AvailableSizes.Contains(size))" /><span>@size</span></label>}</div><small>Escolha os tamanhos que o cliente poderá selecionar.</small></div><div class="bf-upload-field bf-form-grid__full"><label class="bf-file-field"><span>Fotos do produto</span><input id="product-images-input" name="images" type="file" accept="image/png,image/jpeg,image/webp" multiple data-image-preview-input="product-images-preview" /><small>Você pode selecionar várias fotos. JPG, PNG ou WEBP, até 5 MB por arquivo.</small></label><div id="product-images-preview" class="bf-image-upload-preview" data-empty="true"><div class="bf-image-upload-preview__placeholder"><span class="bf-image-upload-preview__icon">+</span><strong>Galeria</strong><span>As fotos selecionadas aparecerão aqui</span></div><div class="bf-image-upload-preview__grid"></div></div></div><label class="bf-check"><input asp-for="IsFeatured" type="checkbox" /><span>Produto em destaque</span></label><div class="bf-form-actions"><a class="bf-btn bf-btn--ghost" asp-controller="Admin" asp-action="Index">Cancelar</a><button class="bf-btn bf-btn--dark" type="submit">Salvar produto <span>→</span></button></div></form></div></section>
