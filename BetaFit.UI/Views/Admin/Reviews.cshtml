@model List<ReviewDto>
@{ViewData["Title"]="Moderação de comentários";}
<section class="bf-section"><div class="bf-container"><span class="bf-eyebrow bf-eyebrow--dark">Administração</span><h1>Comentários e avaliações</h1><p>Somente avaliações aprovadas aparecem na página do produto.</p>
@if(TempData["Success"] is string ok){<div class="bf-alert" role="status">@ok</div>}@if(TempData["Error"] is string error){<div class="bf-alert bf-alert--error">@error</div>}
<form action="/Admin/Reviews/Bulk" method="post" id="review-bulk">@Html.AntiForgeryToken()<label><input type="checkbox" data-review-all/> Selecionar todas</label><select name="status"><option>Aprovado</option><option>Rejeitado</option><option>Pendente</option></select><button class="bf-btn bf-btn--dark" data-confirm="Aplicar a ação às avaliações selecionadas e todas as suas fotos?">Aplicar às selecionadas</button><p>Selecione avaliações para moderar todas as fotos anexadas de uma vez.</p></form>@if(ViewData["ReviewsError"] is string loadError){<div class="bf-alert bf-alert--error" role="alert">@loadError <a href="/Admin/Reviews">Tentar novamente</a></div>}<div class="bf-moderation-list">@foreach(var review in Model){<article class="bf-review-card"><label><input type="checkbox" name="selectedIds" value="@review.Id" form="review-bulk"/> Selecionar avaliação e fotos</label><header><strong>@review.UserName · @review.Rating / 5</strong><span class="bf-status-pill">@review.ModerationStatus</span></header><small>Pedido #@review.OrderId · <a asp-controller="Catalog" asp-action="Details" asp-route-id="@review.ProductId">Produto #@review.ProductId</a> · @review.CreatedAt.ToString("dd/MM/yyyy")</small><p>@review.Comment</p><div class="bf-review-card__photos">@foreach(var photo in review.PhotoUrls){<a href="@photo" target="_blank" rel="noopener"><img src="@photo" alt="Foto enviada pelo cliente" /></a>}</div><form asp-action="ModerateReview" asp-route-id="@review.Id" method="post">@Html.AntiForgeryToken()<button name="status" value="Aprovado" class="bf-btn bf-btn--dark">Aprovar</button><button name="status" value="Rejeitado" class="bf-btn bf-btn--outline">Rejeitar</button><button name="status" value="Pendente" class="bf-btn bf-btn--ghost">Deixar pendente</button></form></article>}
@if(!Model.Any() && ViewData["ReviewsError"] is null){<p class="bf-empty">Ainda não há comentários para avaliar.</p>}</div></div></section>
